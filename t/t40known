#!/usr/bin/env perl
BEGIN { do "./lib/reexec" for grep $_, $ENV{MATHPERL} }
use strict;
use warnings;

use Test::More;

# Tests that a full search of a small range (under -X) reports exactly
# the solutions known in that range. Solutions listed here were found
# independently, by sieving tau over the whole range. Also tests that
# cases known impossible by exception are reported as such.

my $debug = $ENV{DEBUG} ? 'd' : '';

test_pcrul();
test_unforce();
test_pctul();

done_testing();
exit 0;

sub test_pcrul {
    # tau(d .. d + 4) = 8, 8, 4, 4, 18 needs mintau() restricted for
    # repeated 3s, as the lcm of the targets (72) shows but n does not
    is_deeply(found('pcrul', qw{ -x2000 296 5 }), [ 1112 ],
            'pcrul finds f(296, 5)');

    # 484 = 22^2 makes v_0 square, here with batch "2^2 . 2 . 2^3"
    is_deeply(found('pcrul', qw{ -x273600000 484 5 }), [ 273505444 ],
            'pcrul finds f(484, 5): square v_0 takes 2^2 of 2^3');
    # 1764 = 42^2 makes v_4 square, here with batch "2^3 . 2 . 2^2"
    is_deeply(found('pcrul', qw{ -x100000 1760 5 }), [],
            'pcrul reports no false f(1760, 5): square v_4 takes 2^2 of 2^3');

    # f(49, 3) is known impossible by exception, unless we ignore that
    my @lines = `./${debug}pcrul -Ls0 -x100000 49 3 2>&1`;
    ok(!$? && (grep /^403 /, @lines),
            'pcrul reports f(49, 3) impossible by exception')
        or diag_tail(\@lines);
    is_deeply(found('pcrul', qw{ -ix -x100000 49 3 }), [],
            'pcrul -ix searches f(49, 3) regardless');
}

sub test_unforce {
    # Under -F with p = 2 unforced, batches with 2 at v_0 and v_2 such
    # as 2^3 . 2 and 2 . 2^3 are left on the 2^0 tail for the walk to
    # find, so the tail must not fix v_0 odd.
    for my $F (qw{ -F -F2 }) {
        is_deeply(found('pcoul', '-x95047:95048', $F, qw{ 12 3 }),
                [ 95048 ], "pcoul $F f(12, 3) finds 95048 (2^3 . 2)");
        is_deeply(found('pcoul', '-x376549:376550', $F, qw{ 24 3 }),
                [ 376550 ], "pcoul $F f(24, 3) finds 376550 (2 . 2^3)");
        is_deeply(found('pcoul', '-x41139271:41139272', $F, qw{ 24 4 }),
                [ 41139272 ], "pcoul $F f(24, 4) finds 41139272 (2^3 . 2 .)");
    }
}

sub test_pctul {
    # tau(n + id) = tau(n) for 0 <= i < k
    is_deeply(sorted('pctul', qw{ -x600 13 4 }),
            [ 30, 48, 90, 150, 198, 210, 360, 408, 510, 528 ],
            'pctul finds f(13, 4): n prime, so d divisible by 2.3');
    is_deeply(sorted('pctul', qw{ -x2000000 97 7 }),
            [ 33390, 99960, 120750, 390390, 631260, 813120, 1363950 ],
            'pctul finds f(97, 7): n prime, so d divisible by 2.3.5.7');
    is_deeply(sorted('pctul', qw{ -x1000 15 5 }), [
        6, 18, 36, 126, 144, 188, 194, 288, 378, 482, 566, 614, 756
    ], 'pctul finds f(15, 5): n = pq with 3 < k dividing n');
    is_deeply(sorted('pctul', qw{ -x400 27 4 }), [
        58, 64, 88, 158, 182, 188, 190, 338, 364, 388
    ], 'pctul finds f(27, 4): n a prime cube');
    is_deeply(sorted('pctul', qw{ -x6000 30 6 }), [
        376, 388, 1132, 1228, 2596, 5176, 5596, 5932
    ], 'pctul finds f(30, 6): tau(n) = 8');
    is_deeply(sorted('pctul', qw{ -x200 12 3 }), [
        8, 16, 20, 32, 40, 56, 80, 112, 136, 152, 160, 163, 200
    ], 'pctul finds f(12, 3): tau(n) = 6, so squares arise');
    is_deeply(sorted('pctul', qw{ -x1000 45 4 }), [
        54, 108, 162, 378, 432, 486, 756, 864
    ], 'pctul finds f(45, 4): tau(n) = 6, n odd');
    is_deeply(sorted('pctul', qw{ -x30000 98 4 }), [
        109, 409, 1369, 10369, 11065, 11449, 13609, 20109, 29809
    ], 'pctul finds f(98, 4): tau(n) = 6, d odd');
    is_deeply(sorted('pctul', qw{ -x2000 36 2 }), [
        64, 160, 189, 220, 405, 448, 640, 1053, 1120, 1189, 1408, 1485
    ], 'pctul finds f(36, 2): n a square, so v_0 is a square');
    is_deeply(sorted('pctul', qw{ -x20000000 49 3 }), [ 120, 240, 5280, 9360 ],
            'pctul finds f(49, 3): two squares, 2x^2 - y^2 = 49 by Pell');
    # every batch of 2 is ruled out
    my @lines = `./${debug}pctul -Ls0 -x60000 8 5 2>&1`;
    ok((grep /^406 .* p=2 /, @lines),
            'pctul reports no arrangement for f(8, 5)');
    is_deeply(sorted('pctul', qw{ -jd -x400000 15 7 }), [],
            'pctul reports no false f(15, 7)');

    # f(10, k) = 2.f(5, k) for k >= 3: every solution has d == 0 (mod 4)
    @lines = `./${debug}pctul -Ls0 -x200 10 3 2>&1`;
    ok(!$? && (grep m{^201 Dependent - 3:2 f\(5\) # fix 2$}, @lines),
            'pctul reports f(10, 3) dependent on f(5, 3)');
    is_deeply(sorted('pctul', qw{ -jd -x200 10 3 }), [
        12, 24, 36, 48, 84, 96, 108, 132, 168, 192
    ], 'pctul -jd searches f(10, 3) regardless');
    # f(210, 7) >= 2.f(105, 7), but f(105, 7) need not be even
    @lines = `./${debug}pctul -Ls0 -X -x1000 210 7 2>&1`;
    ok(!$? && (grep /^313 .* >= 2\.f\(105, 7\)$/, @lines)
            && !(grep /^201 /, @lines)
            && (grep /^202 Candidate 180 /, @lines),
            'pctul warns that f(210, 7) depends in part on f(105, 7)');

    # f(6, 4) = 2.f(3, 4), and 3 + 3d is never prime
    @lines = `./${debug}pctul -Ls0 -x1000000 6 4 2>&1`;
    ok((grep /^406 .* in f\(3, 4\), on which this depends/, @lines)
            && !(grep /^201 /, @lines),
            'pctul reports no arrangement for f(6, 4), not dependence');
    # tau = 3 needs v_i = q^2: if 3 | d then 9 + d = 9, else one of
    # 9 + d, 9 + 2d is 2 (mod 3)
    @lines = `./${debug}pctul -Ls0 -x1e100 9 4 2>&1`;
    ok((grep /^406 .* p=3 /, @lines) && !(grep /^367 /, @lines),
            'pctul reports no arrangement for f(9, 4) without a search');

    # 25 + d, 25 + 2d squares need d and 2d squares mod 5, but 2 is not
    @lines = `./${debug}pctul -Ls0 -x1e100 25 3 2>&1`;
    ok((grep /^406 .* p=5 /, @lines) && !(grep /^367 /, @lines),
            'pctul reports no arrangement for f(25, 3): 2 is not a square mod 5');
    # while 2 is a square mod 17
    is_deeply(sorted('pctul', qw{ -x10000 289 3 }), [ 2520 ],
            'pctul finds f(289, 3)');

    # f(243, k) is known impossible by exception for k > 4
    @lines = `./${debug}pctul -Ls0 -x100000 243 5 2>&1`;
    ok(!$? && (grep /^403 /, @lines),
            'pctul reports f(243, 5) impossible by exception');
}

# returns an arrayref of the candidates reported, in ascending order,
# or a string describing how the run failed to complete
sub sorted {
    my $c = found(@_);
    return ref($c) ? [ sort { $a <=> $b } @$c ] : $c;
}

# returns an arrayref of the candidates reported, in the order found,
# or a string describing how the run failed to complete (showing the
# tail of its output as a diagnostic)
sub found {
    my($prog, @args) = @_;
    my @lines = `./$debug$prog -Ls0 -X @args 2>&1`;
    my $fail = $? ? "exit status $?"
            : (grep /^367 /, @lines) ? undef
            : 'no final line';
    if (defined $fail) {
        diag("./$debug$prog -Ls0 -X @args");
        diag_tail(\@lines);
        return $fail;
    }
    return [ map /^202 Candidate (\d+)/ ? $1 : (), @lines ];
}

# diag() the last few lines of a run's output: some runs give thousands
sub diag_tail {
    my($lines) = @_;
    my $from = @$lines > 10 ? @$lines - 10 : 0;
    diag(join '', @$lines[$from .. $#$lines]);
}
