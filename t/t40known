#!/usr/bin/env perl
BEGIN { do "./lib/reexec" for grep $_, $ENV{MATHPERL} }
use strict;
use warnings;

use Test::More;

# Tests that a full search of a small range (under -X) reports exactly
# the solutions known in that range. Solutions listed here were found
# independently, by sieving tau over the whole range. Also tests that
# cases known impossible by exception are reported as such.

my $debug = $ENV{DEBUG} ? 'd' : '';

test_pcrul();
test_unforce();

done_testing();
exit 0;

sub test_pcrul {
    # tau(d .. d + 4) = 8, 8, 4, 4, 18 needs mintau() restricted for
    # repeated 3s, as the lcm of the targets (72) shows but n does not
    is_deeply(found('pcrul', qw{ -x2000 296 5 }), [ 1112 ],
            'pcrul finds f(296, 5)');

    # 484 = 22^2 makes v_0 square, here with batch "2^2 . 2 . 2^3"
    is_deeply(found('pcrul', qw{ -x273600000 484 5 }), [ 273505444 ],
            'pcrul finds f(484, 5): square v_0 takes 2^2 of 2^3');
    # 1764 = 42^2 makes v_4 square, here with batch "2^3 . 2 . 2^2"
    is_deeply(found('pcrul', qw{ -x100000 1760 5 }), [],
            'pcrul reports no false f(1760, 5): square v_4 takes 2^2 of 2^3');

    # f(49, 3) is known impossible by exception, unless we ignore that
    my @lines = `./${debug}pcrul -Ls0 -x100000 49 3 2>&1`;
    ok(!$? && (grep /^403 /, @lines),
            'pcrul reports f(49, 3) impossible by exception');
    is_deeply(found('pcrul', qw{ -ix -x100000 49 3 }), [],
            'pcrul -ix searches f(49, 3) regardless');
}

sub test_unforce {
    # Under -F with p = 2 unforced, batches with 2 at v_0 and v_2 such
    # as 2^3 . 2 and 2 . 2^3 are left on the 2^0 tail for the walk to
    # find, so the tail must not fix v_0 odd.
    for my $F (qw{ -F -F2 }) {
        is_deeply(found('pcoul', '-x95047:95048', $F, qw{ 12 3 }),
                [ 95048 ], "pcoul $F f(12, 3) finds 95048 (2^3 . 2)");
        is_deeply(found('pcoul', '-x376549:376550', $F, qw{ 24 3 }),
                [ 376550 ], "pcoul $F f(24, 3) finds 376550 (2 . 2^3)");
        is_deeply(found('pcoul', '-x41139271:41139272', $F, qw{ 24 4 }),
                [ 41139272 ], "pcoul $F f(24, 4) finds 41139272 (2^3 . 2 .)");
    }
}

# returns an arrayref of the candidates reported, in the order found,
# or a string describing how the run failed to complete
sub found {
    my($prog, @args) = @_;
    my @lines = `./$debug$prog -Ls0 -X @args 2>&1`;
    return "exit status $?" if $?;
    return 'no final line' unless grep /^367 /, @lines;
    return [ map /^202 Candidate (\d+)/ ? $1 : (), @lines ];
}
