#!/usr/bin/env perl
BEGIN { do "./lib/reexec" for grep $_, $ENV{MATHPERL} }
use strict;
use warnings;

use Test::More;

# Tests of the batches listed by -a.

my $prog = './pcoul';
if ($ENV{DEBUG}) {
    $prog =~ s/pc/dpc/
            or die "Could not munge program name '$prog'";
}

test_restrict();
test_fixed();
test_square_init();
test_unforce();

done_testing();
exit 0;

sub test_restrict {
    # -fr applies the caps of -p and -px to the forced primes
    my @args = qw{ -x1e20 -f3 12 4 };
    my $all = batches(@args);
    is(scalar(@$all), 52, 'D(12,4) has 52 batches');
    is_deeply(batches('-fr', @args), $all,
            '-fr with no cap restricts nothing');
    is_deeply(batches(qw{ -fr -p100 }, @args), $all,
            '-fr with cap above the forced primes restricts nothing');

    # -p caps only 3^2, 3^5, 3^11
    my $capped = [ grep !/\b3\^(?:2|5|11)\b/, @$all ];
    is_deeply(batches(qw{ -fr -p2 }, @args), $capped,
            '-fr -p2 removes only batches with capped powers of 3');
    my $capped3 = [ grep !/\b3\^3\b/, @$capped ];
    is_deeply(batches(qw{ -fr -p2 -px2^3 }, @args), $capped3,
            '-fr -p2 -px2^3 also removes batches with 3^3');
    is_deeply(batches('-fr', '-p2', '-px2^3,2^1', @args), [],
            '-fr with every power of 3 capped leaves no batches');
}

sub test_fixed {
    # -a4 also lists the batches that fully allocate some value, each as
    # soon as it does so: "2^5 . 2" and ". 2^5 ." are listed before 3 is
    # allocated. Any value forced square must still be able to be one:
    # "3^5 2 ." cannot be listed, since v_1 = 2x^2 would need x^2 == 2
    # (mod 3).
    my @args = qw{ -x1e30 6 3 };
    my %plain = map +($_ => 1), @{ batches('-jp', @args) };
    my @fixed = grep !$plain{$_}, @{ batches('-a4', @args) };
    is_deeply(\@fixed, [
        '2^5 . 2', '3^5 2^2 .', '. 2^2.3 .', '. 2^2 3^5', '. 2^5 .',
        '. 2.3^2 .', '. 2 3^5', '2.3^2 . 2^2', '2 3^5 2^2',
    ], '-a4 lists a batch once it fully allocates a value');
}

sub test_square_init {
    # -I makes v_0 = 7^3.z^2 before the batch for 2 is chosen; with
    # 2^2 at v_0 and 2^5 at v_4, v_4 / 2^5 = (343z^2 + 1) / 8 is odd
    # for z == +-1 (mod 8)
    is_deeply(batches(q{-I"7^3 . . . ."}, qw{ -x1e16 36 5 }), [
        '7^3 2^5 . 2 .', '7^3 2^8 . 2 .', '7^3 2^17 . 2 .',
        '7^3.2^2 . 2 . 2^5', '7^3.2^2 . 2 . 2^8', '7^3.2^2 . 2 . 2^17',
    ], 'a square from -I keeps batches where 2^2 of 2^5 hits it');
}

sub test_unforce {
    # -F2 leaves batches of 2 with no odd x (here 2^3 . 2 and 2 . 2^3)
    # for the walk to find. -F3 does not unforce 2, so keeps them.
    my @args = qw{ -x1e30 12 3 };
    my $all = batches(@args);
    is_deeply($all, [
        '2^2 . 2', '2^5 . 2', '2^3 . 2', '2 . 2^2', '2 . 2^5', '2 . 2^3',
        '. . .',
    ], 'D(12,3) batches include 2^3 . 2 and 2 . 2^3');
    my $odd = [ grep !/\b2\^3\b/, @$all ];
    is_deeply(batches('-F2', @args), $odd,
            '-F2 leaves 2^3 . 2 and 2 . 2^3 to the walk');
    is_deeply(batches('-F3', @args), $all, '-F3 keeps them forced');

    # after the tail for 3, 5 must still be forced
    my %b = map +($_ => 1), @{ batches(qw{ -F3 -x1e40 160 6 }) };
    ok($b{'5^4 2 . 2^4 . 2.5'}, '-F3 still forces 5 after the tail for 3');
}

# returns an arrayref of the batches listed, in order
sub batches {
    my(@args) = @_;
    my @lines = `$prog -Ls0 -a @args 2>&1`;
    return [ map /^203 b\d+: (.*?)(?: \[sq=\d+\])? \[aq=/ ? $1 : (), @lines ];
}
