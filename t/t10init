sub expect_recover_log {
    my($legend, $code, $re, $args, $content) = @_;
    my $fh = temp_log($content);
    my $lines = run_test($type, [ '-r' . $fh->filename, @$args ], 1)
            // return;
    my $line = $lines->{$code} && $lines->{$code}[-1];
    if (!$line || $line !~ $re) {
        fail($legend);
        diag_lines($lines);
        diag($line) if $line;
        return;
    }
    pass($legend);
    return;
}

sub expect_log {
    my($legend, $code, $I, $args) = @_;
    my $fargs = length($I) ? qq{-I"$I"} : undef;
    my $lines = run_test($type, [ grep defined, $fargs, @$args ])
            // return;
    ok($lines->{$code}, $legend) or diag_lines($lines);
    return;
}

sub diag_lines {
    my($lines) = @_;
    diag("saw log lines: @{[ join ', ', sort keys %$lines ]}");
    return;
}

sub run_test {
    my($type, $args, $loose) = @_;
    my $prog = $type->prog('cul');
    if ($ENV{DEBUG}) {
        $prog =~ s/pc/dpc/
                or die "Could not munge program name '$prog'";
    }
    my %lines;
    open my $PIPE, "$prog @$args |"
            or die "Could not open '$prog @$args'";
    while (<$PIPE>) {
        chomp;
        /^(\d+)/ ? push(@{ $lines{$1} }, $_)
            : $loose ? push(@{ $lines{''} }, $_)
            : diag($_);
    }
    close $PIPE;
    return \%lines;
}
