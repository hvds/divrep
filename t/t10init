}

if (1) {
    # A -I pattern or manually-constructed recovery line may indicate
    # that we've just allocated a complete batch, with no further progress.
    local $type = Type->new('o');
    expect_recover(q{recover a named batch id with no progress yet},
        [qw{ -x1e10 -f3 -W1000 12 4 }],
        ['305 b5: 2^2.3 . 2 3'],
        'b5: 2^2.3 . 2 3 W(26723,3,2)',
    );
}


if (1) {
    # Recovery honours the recursion the recovery line shows, rather than
    # asking the gate again, so -ja1 can be turned on or off mid-run (it
    # learns its costs during the run, so its decisions would differ).
    local $type = Type->new('o');
    my $args245 = [qw{ -x1e12 24 5 }];
    expect_recover(q{recover a recursion, turning -ja1 on},
        [ '-ja1', @$args245 ],
        ['305 b26: 2^3.3.317^2 5^2 2.97^2 3^2 2^2'],
        'b26: 2^3.3.317^2 5^2 2.97^2 3^2 2^2',
    );
    expect_recover(q{recover -ja1 after a candidate},
        [ '-ja1', @$args245 ],
        ['202 Candidate 15537948 (0.10s)',
         '305 b26: 2^3.3.317^2 5^2 2.97^2 3^2 2^2'],
        'b26: 2^3.3.317^2 5^2 2.97^2 3^2 2^2',
    );
    # -ja2 marks in a 315 line only the levels whose position it chose
    # against the strategy's, and the others are replayed by the strategy.
    expect_recover(q{recover -ja2 from a partly expanded line},
        [ '-ja2', qw{ -x1e14 12 4 } ],
        ['315 b0: 2^2.3 229^2 2.19^2(4) 3.11^2(3) (0.01s)'],
        'b0: 2^2.3 229^2 2.19^2 3.11^2: 0 / 1818',
    );
    # A 316 line records what -ja has learnt up to the progress line it
    # precedes: the cost counted, the walks seen, then for each level the
    # gate's walk samples and -ja2's actual and estimated costs of walks
    # and of walk_1_set(), then those of recursing by size of node.
    {
        my $args = [ '-ja2', qw{ -x1e14 12 4 } ];
        my $at = '315 b0: 2^2.3 229^2 2.19^2(4) 3.11^2(3) (0.01s)';
        # walks having cost a million times their estimate
        my $dear = join ' ', '316 5000 0',
                map "$_:0,0,0,1000,0.001,0,0", 1 .. 5;
        expect_recover_log(q{recover -ja2 cost counted from a 316 line},
            369, qr{^369 cost counted 5\d{3}\.\d\ds}, $args,
            ['316 5000 0', $at]);
        expect_recover_log(q{ignore a 316 line after the last progress line},
            369, qr{^369 cost counted \d\.\d\ds}, $args,
            [$at, '316 5000 0']);
        expect_recover_log(q{reject a malformed 316 line},
            517, qr{^517 could not parse learnt costs}, $args,
            ['316 5000 0 1:1,2', $at]);
        expect_recover_log(q{reject a 316 line with an unknown band},
            517, qr{^517 could not parse learnt costs}, $args,
            ['316 5000 0 r-14:1,2', $at]);
        expect_recover_log(q{recover -ja2 costs by size from a 316 line},
            369, qr{^369 cost counted 5\d{3}\.\d\ds}, $args,
            ['316 5000 0 1:0,0,0,0,0,0,0 r-15:1,2 r0:1,200 s-3:1,2', $at]);
        # and those learnt below one fixed square: a third pair for each
        # level, the walk samples there, and recursing by size of node
        expect_recover_log(q{recover -ja2 costs below a square from a 316},
            369, qr{^369 cost counted 5\d{3}\.\d\ds}, $args,
            ['316 5000 0 1:0,0,0,0,0,0,0,3,4 q4:1,2,3 r-15:1,2 f-3:1,2', $at]);
        expect_recover_log(q{reject a 316 line with malformed walk samples},
            517, qr{^517 could not parse learnt costs}, $args,
            ['316 5000 0 q4:1,2', $at]);
        expect_recover_log(q{ignore a 316 line without -ja},
            200, qr{^200 f\(12, 4\) = 19940 }, [qw{ -x1e14 12 4 }],
            ['316 5000 0 1:1,2', $at]);
        my($plain, $learnt) = map {
            my $fh = temp_log($_);
            my $lines = run_test($type, [ '-r' . $fh->filename, @$args ], 1);
            ($lines->{367}[-1] // '') =~ /recurse (\d+)/ ? $1 : 0;
        } [$at], [$dear, $at];
        ok($plain && $learnt && $plain != $learnt,
                q{recover -ja2 choices from a 316 line})
            or diag("recurse $plain without, $learnt with");
    }
    expect_recover(q{recover a recursion, turning -ja1 off},
        $args245,
        ['305 b0: 2^5.3 271^2 2 3.17^2 2^2'],
        'b0: 2^5.3 271^2 2 3.17^2 2^2: 0 / 245',
    );
}

