    # on, not restart the loop.
    local $type = 'o';
    expect_diag(q{progress shows a failed apply}, 488,
        [qw{ -x1e12 24 5 }],
        'b0: 2^5.3 5^2 2.79^2 3.7^2 2^2',
    );
    expect_recover(q{recover a failed apply, continuing the loop},
        [qw{ -x1e12 24 5 }],
        ['202 Candidate 4926769824 (0.00s)',
         '202 Candidate 1048792224 (0.00s)',
         '305 b0: 2^5.3 5^2 2.79^2 3.7^2 2^2 (0.00s)'],
        'b0: 2^5.3 5^2 2.83^2 3.7^2 2^2',
    );
}

sub test_committed_after_candidate {
    # Having chosen to allocate at v_2, the run stays with that after the
    # candidate found here, and moves on to the next prime: it does not go
    # back to walk "17^2 2^2.3 . 2 3^2", cheaper though that has become.
    # Recovery is used only to start close to that point.
    local $type = 'o';
    expect_recover(q{a candidate does not reopen the choice to allocate},
        [qw{ -x1e20 12 5 }],
        ['202 Candidate 39679072 (0.00s)',
         '305 b11: 17^2 2^2.3 5^2 2 3^2: 0 / 75 (0.00s)'],
        'b11: 17^2 2^2.3 7^2 2 3^2',
        2,
    );
}

sub test_recover_p0_tail {
