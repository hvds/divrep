if (1) {
    # STRATEGY_6X: allocation patterns like "...2^{4+} . 2z^2..." trigger
    # a strategy switch taking advantage of the maths to restrict to a much
    # smaller search space.
    #
    # In the tests we must set gain (-g) high enough to avoid being diverted
    # to a full walk_v() sweep for the small -x values we test.
    local $type = Type->new('o');

    # -x must be at least 19600, the residue of 2^4.5^2 . 2.3^4

    expect_diag(q{6x pattern is identified and applied, 30 4}, 4,
        [qw{ -g1000 -x20000 -jp -b2 30 4 }],
        'b2: 2^4.5^2 . 2.3^4 . 6X(13,0,4)',
    );
    expect_recurse_count(q{6x search is exhaustively correct, 30 4}, 5,
        [qw{ -g1000 -x20000 -jp -b2 30 4 }]);

    expect_diag(q{6x pattern is identified and applied, 90 4}, 4,
        [q{-I"2^4 . 2 ."}, qw{ -g1000 -x142838800 -f2 -jp -b4 90 4 }],
        'b4: 2^4.5^2.7^2 . 2.3^4 . 6X(613,0,12)',
    );
    # (one fewer than is applied: 59^2 after 5^2 has roots 1547 and 1934
    # mod 59^2, both past the greatest root 939, see reject_square())
    expect_recurse_count(q{6x search is exhaustively correct, 90 4}, 58,
        [q{-I"2^4 . 2 ."}, qw{ -g1000 -x142838800 -f2 -jp -b4 90 4 }]);
}

if (1) {
    # STRATEGY_6X recovery: a "6X(p,vi,a)" diag line (see above) must be
    # enough to resume best_6x()'s own search loop exactly where it left
    # off - including re-trying 'a' itself (hitting both of its walk_1()
    # branches unconditionally, by design; see best_6x()'s own comment),
    # then continuing on to whatever the search does next.
    #
    # Since recovery does not re-explore already-completed ancestor
    # branches above the recorded point, a recovered run's recurse count
    # is necessarily lower than the equivalent cold run's - the expected
    # counts here were found the same way as the plain-run counts above:
    # by comparing against the -dW trace at the recorded point.
    local $type = Type->new('o');

    expect_recover_recurse_count(q{recover 6x from its own diag point, 30 4},
        1, ['305 b2: 2^4.5^2 . 2.3^4 . 6X(13,0,4)'],
        [qw{ -g1000 -x20000 -jp -b2 30 4 }]);

    expect_recover_recurse_count(q{recover 6x from its own diag point, 90 4},
        54, ['305 b4: 2^4.5^2.7^2 . 2.3^4 . 6X(613,0,12)'],
        [q{-I"2^4 . 2 ."}, qw{ -g1000 -x142838800 -f2 -jp -b4 90 4 }]);
}

if (1) {
    # run_flip_pqsq(): when a p^z allocation is too high to leave any
    # (z,z,2) partitions, we deallocate it and instead exhaustively try
    # (2z,z) partitions directly (see its own comment for the maths).
    local $type = Type->new('o');

    expect_diag(q{flip is identified and applied, 36 4}, 80,
        [qw{ -j2 -x1e6 -b7 36 4 }],
        'b7: 2^2.5^2 . 2.11^5 . F(2,23)',
    );

    expect_recover_recurse_count(q{recover flip from its own diag point, 36 4},
        128, ['305 b7: 2^2.5^2 . 2.11^5 . F(2,23)'],
        [qw{ -j2 -x1e6 -b7 36 4 }]);

    # A candidate logged after the last 305 line can lower zmax enough that
    # the flip allocation now overflows; applying it should be deferred.
    TODO: {
        local $TODO = q{defer trailing 202 until flip reapply is done};
        expect_recover(q{recover flip with trailing candidate},
            [qw{ -j2 -x1e12 36 4 }],
            [q{305 b6: 2^2.3.31^2 . 2.7^5.5443^2 3^8 F(2,587)},
             q{202 Candidate 460546327700 (70.18s)}],
            q{b6: 2^2.3.31^2 . 2.7^5 3^8 F(2,587)});
    }

    # there can be unforced allocations before the flip set
    expect_recover(q{recover flip past prior allocations to the same v_i},
        [qw{ -x103148643381388141823 -j2 -f3 -g20 324 3 }],
        ['305 b0: 2^2.3^2.5^2.7^2 . 2.11^2.13^2.79^5 F(2,3491)'],
        'b0: 2^2.3^2.5^2.7^2 . 2.11^2.13^2.79^5 F(2,3491)');
}

if (1) {
    # -j4 and -js can allocated power p^{2^x-1}, a more complex pathway
    # that has more recover paths to consider.
    # For each testcase where they are relevant, these tests should show:
    # a) that recovered allocations are in the correct recurse order;
    # b) that internal t_allocation.lim values are correctly recalculated;
    # c) that the best recovered candidate is correctly recorded.
    local $type = Type->new('o');
    my $args124j4 = [qw{ -j4 -x1e10 -f3 12 4 }];

    expect_recover(q{recover -j4 from expanded line},
        $args124j4,
        ['315 b0: 2^2(1).3(2) 5^2(3) 2.13^2 3.7^2(4) (0.00s) [34 2 0 1]'],
        'b0: 2^2.3 5^2 2.13^2 3.7^2: 0 / 2012',
    );

    # a candidate found after the last logged progress line must not
    # tighten the search bound until after the recorded position has
    # been fully replayed - doing it first would make the now-smaller
    # bound disagree with the order recorded under the original, larger
    # one.
    expect_recover(q{recover -j4 trailing candidate after expanded line},
        $args124j4,
        ['315 b0: 2^2(1).3(2) 5^2(3) 2.13^2 3.7^2(4) (0.00s) [34 2 0 1]',
         '202 Candidate 185622924 (0.00s)'],
        'b0: 2^2.3 5^2 2.13^2 3.7^2: 0 / 37',
    );

    # if the search backtracks (here, past the forced primes entirely -
    # the batch id changes from b0 to b1) after the last "315" line was
    # written, its recorded order is stale; recovery must fall back to
    # the following "305" line's own genuine data rather than silently
    # trusting the outdated order.
    expect_recover(q{recover -j4 expanded order superseded by backtrack},
        $args124j4,
        ['315 b0: 2^2(1).3(2) 5^2(3) 2.13^2 3.7^2(4) (0.00s) [34 2 0 1]',
         '305 b1: 2^2 3^2 2.11^2 5^2: 3 / 8 (0.02s) [2661 279 207 4]'],
        'b1: 2^2 3^2 2.11^2 5^2: 3 / 45912',
    );

    # With n = 64 every tau is a power of 2, so all of best_v4()'s choices
    # depend on zmax. Here the candidates found since the choice of v_1 at
    # level 5 would make best_v() choose differently on recovery, so the
    # 315 line marks that level alone.
    expect_recover(q{recover -j4 from a level marked after candidates},
        [qw{ -j4 -x1e15 64 3 }],
        ['202 Candidate 2260515199304 (0.00s)',
         '202 Candidate 409736749784 (0.00s)',
         '202 Candidate 157156822184 (0.00s)',
         '202 Candidate 41769309944 (0.00s)',
         '202 Candidate 3824122664 (0.00s)',
         '202 Candidate 2931871304 (0.01s)',
         '202 Candidate 220522664 (0.01s)',
         '202 Candidate 167663144 (0.01s)',
         '315 b0: 2^3 3.5.29(5).47.71.79 2.7 (0.02s) [1394 458 49]'],
        'b0: 2^3 3.5.29.47.71.79 2.7',
    );

    # -js (a fixed, user-specified allocation order) can also produce
    # "315" lines, but its own choices don't depend on the search bound
    # the way -j4's do, so a plain "305" line is enough to confirm its
    # recovery works.
    expect_recover(q{recover -js},
        [ '-js1,3', @{[ qw{ -x1e10 -f3 12 4 } ]} ],
        ['305 b0: 2^2.3 5^2 2 3.7^2: 94 / 340135'],
        'b0: 2^2.3 5^2 2 3.7^2: 94 / 340135',
    );
}

if (1) {
    # Progress may show an allocation that failed to apply (here 79^2 at
    # v_2, given the candidates so far). Recovery should retry it and move
    # on, not restart the loop.
    local $type = Type->new('o');
    expect_diag(q{progress shows a failed apply}, 488,
        [qw{ -x1e12 24 5 }],
        'b0: 2^5.3 5^2 2.79^2 3.7^2 2^2',
    );
    expect_recover(q{recover a failed apply, continuing the loop},
        [qw{ -x1e12 24 5 }],
        ['202 Candidate 4926769824 (0.00s)',
         '202 Candidate 1048792224 (0.00s)',
         '305 b0: 2^5.3 5^2 2.79^2 3.7^2 2^2 (0.00s)'],
        'b0: 2^5.3 5^2 2.83^2 3.7^2 2^2',
    );
}

