#!/usr/bin/env perl
BEGIN { do "./lib/reexec" for grep $_, $ENV{MATHPERL} }
use strict;
use warnings;

use Test::More;
use File::Temp ();
our $type;
my %PROG = (o => './pcoul', a => './pcaul');

# each of these tests one aspect of -I, of recovery, or of the two together
test_init();
test_recover();
test_recover_trailing();
test_recover_ruled_out();
test_batch_id_64bit();
test_recover_j0123();
test_6x();
test_recover_6x();
test_flip();
test_recover_j4();
test_recover_failed_apply();
test_committed_after_candidate();
test_recover_p0_tail();
test_recover_complete_batch();
test_recover_last_batch();
test_no_forced_primes();
test_recover_init();
test_divisors_of_n();

done_testing();
exit 0;

sub test_init {
    # Test cases for -I without recovery
    local $type = 'o';

    my $args65 = [qw{ -x1e20 6 5 }];
    my $args63 = [qw{ -x1e20 6 3 }];
    my $args124 = [qw{ -x1e20 -f3 -jp 12 4 }];
    my $args124b = [qw{ -x1e20 -f2 -jp 12 4 }];

    expect_fail(q{fail if the minimum is above the maximum},
            [qw{ -x1e6:1e5 12 4 }], qr{^require min < max});
    expect_fail(q{fail if the range is empty},
            [qw{ -x1e6:1e6 12 4 }], qr{^require min < max});
    expect_log(q{fail if not enough elements},
            502, '2 . 2^2 .', $args65);
    expect_log(q{fail if too many elements},
            511, '2 . 2^2 .', $args63);
    # CHECKME: should we detect this elsewhere for more specific error?
    expect_log(q{fail if power does not divide},
            521, '. 2 . 2^3 .', $args65);
    expect_log(q{fail if inconsistent (fixed) powers},
            521, '. 2 . 2 .', $args65);
    # CHECKME: should we detect this earlier?
    expect_log(q{fail if not a quadratic root},
            406, '. 2 5 2^2 .', $args65);
    # CHECKME: should we detect this earlier?
    expect_log(q{fail if inconsistent (floating) powers},
            406, '. 11^2 . 11^2 .', $args65);

    my $result65 = '10093613546512321';
    my $result124 = '19940';
    expect_result(q{simple find f(6,5)},
            $result65, '', $args65);
    expect_result(q{constraint on 2 for f(6,5)},
            $result65, '. 2 . 2^2 .', $args65);
    expect_result(q{constraint on 3 for f(6,5)},
            $result65, '. . 3^2 . .', $args65);
    # -f2 ignored for n % 3 != 0
    expect_result(q{constraint on unfixed 3 for f(12,4)},
            $result124, '. 3 . .', $args124b);
    expect_result(q{constraint on float for f(6,5)},
            $result65, '. . . . 5^2', $args65);
    expect_result(q{constraint on 2+float for f(6,5)},
            $result65, '. 2 . 2^2 5^2', $args65);
    expect_result(q{constraint on 3+float for f(6,5)},
            $result65, '. . 3^2 . 5^2', $args65);

    my $result124b = 999649;
    expect_result(q{constraint on sub-high float for f(12,4)},
            $result124b, '. . . 83', $args124);
    expect_result(q{constraint on 2 + sub-high for f(12,4)},
            $result124b, '. 2 . 2^2.83', $args124);
    expect_result(q{allow products in -I},
            $result124b, '1 2 1 332', $args124);
    expect_log(q{fail if a product repeats a prime},
            518, '. . 3.6 .', $args124);
    expect_log(q{fail if a prime factor is too large},
            517, '. . . 18446744073709551629', $args124);
    expect_log(q{fail if a number is missing},
            519, '. . 3. .', $args124);
    expect_result(q{constraint on 3 + sub-high for f(12,4)},
            $result124b, '. . 3 83', $args124);
    # the range is min < v_0 <= max, wherever a walk happens to start
    expect_result(q{a solution at the minimum is not in range},
            49147, '', [qw{ -x19940:1e6 12 4 }]);
    expect_result(q{nor is one below the minimum},
            648475, '', [qw{ -x648474:2e6 6 3 }]);
    # and no walk should try a value that is not above the minimum
    {
        my $lines = run_test($type, [qw{ -x19940:19941 12 4 }]) // {};
        like($lines->{367}[-1] // '', qr{ walkc 0 },
            q{a walk does not try the minimum});
    }
    # -k tries primes to an odd power first, where that leaves a Pell equation
    expect_result(q{-k find f(6,5)},
            $result65, '', [qw{ -k1000 -x1e20 6 5 }]);
    expect_result(q{-k -W find f(6,5)},
            $result65, '', [qw{ -k1e5 -W100 -x1e17 6 5 }]);
    for my $opts (
        [], [qw{ -k30 }], [qw{ -k1e4 }], [qw{ -k1e4 -W100 }], [qw{ -k1e4 -j4 }],
    ) {
        my $lines = run_test($type, [ @$opts, qw{ -X -x1e13 6 4 } ], 0);
        is(0 + @{ $lines->{202} // [] }, 21,
                "all f(6,4) candidates to 1e13 found with '@$opts'");
    }
    # not in a batch STRATEGY_6X takes, where the pass would be wasted
    {
        my @walks = map {
            my $lines = run_test($type, [ @$_, qw{ -b0 -x1e18 18 5 } ], 0);
            ($lines->{367}[0] // '') =~ /walk (\d+)/ ? $1 : -1;
        } [], [qw{ -k1e4 }];
        is($walks[1], $walks[0], '-k makes no pass in a STRATEGY_6X batch');
    }
    # a position with tau 6 left is passed over where another has 18
    # and nothing is allocated there, so that -W need not sweep it
    for my $opts (
        [], [qw{ -k30 }], [qw{ -k1e4 }],
        [qw{ -k30 -W100 }],
    ) {
        my $lines = run_test($type, [ @$opts, qw{ -X -x1e10 18 3 } ], 0);
        my %seen;
        ++$seen{$_} for map /^202 Candidate (\d+)/, @{ $lines->{202} // [] };
        is(0 + keys %seen, 56,
                "all f(18,3) candidates to 1e10 found with '@$opts'");
    }
    # v + 1 = 64013.100003^2: with nothing for trial division to find,
    # the ladder finds 64013 and is left with the square of a prime
    {
        my $v = '640168408376116';
        my $lines = run_test($type, [
            '-X', '-x' . ($v - 1) . ":$v", 6, 2,
        ], 0);
        is(join(' ', map /^202 Candidate (\d+)/, @{ $lines->{202} // [] }),
                $v, 'the ladder accepts a prime squared as what is left');
    }
    # A walk over squares queues each root, to be tested with the rest.
    # In each of these v = 2r^2 with v + 1 good, where r is a product
    # of primes that trial division will not find: too many of them in
    # the first two.
    for (
        [ 'square walk rejects a root that is pqr', 18, '2 3^2.19^2',
                '1713329412856343796186167534161:1713329412856343796186167534163',
                '' ],
        [ 'Pell walk rejects a root that is pq', 30, '2 3^4.51899',
                '20602546734719875598683297:20602546734719875598683299',
                '' ],
        [ 'square walk accepts a root that is pq', 18, '2 3^2.11^2',
                '34862081214054703057:34862081214054703059',
                '34862081214054703058' ],
        [ 'unfactored values above 2^64 are factorized', 18,
                '34862081214054703058 34862081214054703059',
                '34862081214054703057:34862081214054703059',
                '34862081214054703058' ],
    ) {
        my($legend, $n, $init, $range, $expect) = @$_;
        my $lines = run_test($type, [
            '-X', qq{-I"$init"}, "-x$range", $n, 2,
        ], 0);
        is(join(' ', map /^202 Candidate (\d+)/, @{ $lines->{202} // [] }),
                $expect, $legend);
    }

    count_batch(q{batches without constraint},
            56, '', $args124);
    count_batch(q{batches with empty constraint},
            56, '. . . .', $args124);
    count_batch(q{batches with constraint on 2},
            6, '. 2^2 . 2', $args124);
    count_batch(q{batches with constraint on 3},
            8, '. 3^2 . .', $args124);
    count_batch(q{batches with unfixed constraint on 3},
            8, '. 3^2 . .', $args124b);
    # float takes out batches with t=4 or t=6 accounted for, and some
    # quadratic root violations
    count_batch(q{batches with floating constraint},
            21, '. . 5 .', $args124);
    count_batch(q{batches in combination 2+float},
            4, '. 2^2 5 2', $args124);
    count_batch(q{batches in combination 3+float},
            4, '. 3^2 5 .', $args124);
    count_batch(q{no batches for a -I batch above the maximum},
            0, '2^17 . 2 . 2^2', [qw{ -x100000 36 5 }]);

    # batch selection (-b) must be honoured for a batch that -I completes
    # entirely by itself, whether or not -W is also in use.
    for my $w (0, 1) {
        my $legend = $w
            ? q{-b excludes a complete -I batch, with -W}
            : q{-b excludes a complete -I batch, without -W};
        expect_recurse_count($legend, 0, [
            ($w ? '-W100' : ()),
            q{-I"2^2.3 . 2 3"}, qw{-x1e12 -f3 -a1 -b1 12 4},
        ]);
    }

    {
        my $args124W = [qw{ -x1e12 -f3 -W100 -dW1 -Ls0 12 4 }];
        my $expect = q{b0: 2^2.3 . 2 3 W(316223,3,2)};
        for (
            [q{start midp on init partial}, '2^2 . 2 .'],
            [q{start midp on init full}, '2^2.3 . 2 3']
        ) {
            my($legend, $init) = @$_;
            my $lines = run_test($type, [ qq{-I"$init"}, @$args124W], 1);
            # on batch completion, we hit process_batch() and therefore midp
            # before any diag, so we never show '2^2.3 . 2 3' alone
            my $gotlines = $lines->{''};
            if (!$gotlines || @$gotlines != 1 || $gotlines->[0] ne $expect) {
                fail($legend);
                diag_lines($lines);
                diag($_) for @{ $gotlines // [] };
            } else {
                pass($legend);
            }
        }
    }
}

sub test_recover {
    # Test cases for recovery without -I
    local $type = 'o';

    my $args65 = [qw{ -x1e20 -f3 6 5 }];
    my $args65W = [qw{ -x1e20 -f3 -W1000 6 5 }];
    my $args124W = [qw{ -x1e10 -f3 -W1000 12 4 }];
    expect_recover(q{recover empty}, $args65,
        [],
        'b*: . 2 . 2^2 .',
    );
    expect_recover(q{recover start}, $args65,
        ['305 b*: . 2 . 2^2 .'],
        'b*: . 2 3^2 2^2 .',
    );
    expect_recover(q{recover CRLF}, $args65,
        ["305 b*: . 2 . 2^2 .\r"],
        'b*: . 2 3^2 2^2 .',
    );
    expect_recover(q{recover process_batch}, $args65,
        ['305 b*: . 2 3^2 2^2 .'],
        'b0: . 2 3^2 2^2 5^2',
    );
    expect_recover(q{recover walk}, $args65,
        ['305 b0: . 2 3^2 2^2 5^2: 31 / 55555555555555554'],
        'b0: . 2 3^2 2^2 5^2: 31 / 55555555555555554',
    );
    expect_recover(q{recover candidate}, $args65,
        ['202 Candidate 10093613546512321 (0.00s)',
         '305 b0: . 2 3^2 2^2 5^2: 31 / 55555555555555554'],
        'b0: . 2 3^2 2^2 5^2: 31 / 5607563081394',
    );
    expect_recover(q{recover midp}, $args65W,
        ['305 b0: . 2 3^2 2^2 5^2 W(9929,3,0)'],
        'b0: . 2 3^2 2^2 5^2 W(9929,3,0)',
    );
    expect_recover(q{recover midp walk}, $args65W,
        ['305 b0: . 2 3^2 2^2 5^2 W(9929,3,0): 271419930 / 563529263'],
        'b0: . 2 3^2 2^2 5^2 W(9929,3,0): 271419930 / 563529263',
    );
    # 31607^2 cannot be allocated at v_2; the sweep goes on to the next prime
    expect_recover(q{recover midp from a prime that could not be allocated},
        $args124W, ['305 b0: 2^2.3 . 2 3 W(31607,3,2)'],
        'b0: 2^2.3 . 2 3 W(31601,3,2)',
    );
    expect_recover(q{recover -k pass}, [qw{ -x1e20 -f3 -k1000 6 5 }],
        ['305 b0: . 2 3^2 2^2 5^2 W(769,2,0)'],
        'b0: . 2 3^2 2^2 5^2 W(769,2,0)',
    );
    expect_recover_next_batch(
        q{-W: batch numbering survives recovering mid-sweep},
        $args124W, ['305 b0: 2^2.3 . 2 3 W(1009,3,1)'],
        'b1: 2^2 3^2 2 .',
    );
    # the candidate has 127^2 at v_2, the entry after the one recovered
    {
        my $fh = temp_log(['305 b1: 3^2 2^2 . W(127,3,1): 5623 / 8610']);
        my $lines = run_test($type, [
            '-r' . $fh->filename, qw{ -b1 -W100 -X -x1e10 18 3 },
        ], 1);
        ok(scalar(grep /^202 Candidate 1477626075 /, @{ $lines->{202} // [] }),
                q{-W: recovery mid-sweep tries the same p at later positions});
    }
}

sub test_recover_trailing {
    # A candidate after the last progress line, such as one copied in from
    # another run, is applied once the position shown has been restored.
    local $type = 'o';

    # It leaves no room for 211^2 at v_3, so the search moves to the next
    # power there; no later line may show 211^2.
    expect_recover(q{recover with a trailing candidate that ends a level},
        [qw{ -x1e12 24 5 }],
        ['202 Candidate 41139272 (0.00s)',
         '305 b94: 2 3^2 2^2 211^2 2.3: 1 / 12 (0.76s)',
         '202 Candidate 15537949 (0.00s)'],
        'b94: 2 3^2 2^2 5^5 2.3');

    # One not above the minimum leaves nothing to search: it is the result.
    my $args = [qw{ -x19940:1e6 12 4 }];
    my $log = ['305 b0: 2^2.3 13^2 2 3: 75 / 246 (0.00s)',
        '202 Candidate 19940 (0.00s)'];
    expect_recover_result(q{a trailing candidate at the minimum is the result},
        19940, $log, $args);
    expect_recover_recurse_count(q{and nothing more is searched},
        0, $log, $args);
}

sub test_recover_ruled_out {
    # A run cannot log a batch after a candidate that leaves no room for
    # it. Recovery must stop there, not carry on from some other batch.
    local $type = 'o';
    for (
        [ 100000, 'b39: 2^17 3^8 2 . 2^2.3' ],
        [ 1000, 'b32: 2^11 3^17 2 . 2^2.3' ],
    ) {
        my($cand, $line) = @$_;
        expect_recover_fail(
            qq{recovery stops at a batch that candidate $cand rules out},
            [qw{ -x1e20 36 5 }],
            ["202 Candidate $cand (0.00s)", "305 $line (0.00s)"],
            qr{^failed to inject});
    }

    # But a run stays committed to what was allocated when it found its
    # best candidate, until it returns there. The lines it writes meanwhile
    # can show an allocation that the candidate itself has just ruled out,
    # with more beneath it. Recovery must resume after that allocation.

    # Here 5 at v_1 allows nothing less than the candidate.
    expect_recover(q{recover beneath a value whose least is the candidate},
        [qw{ -j4 -x1e12 20 2 }],
        ['202 Candidate 5264 (0.00s)',
         '315 b0: 2^4.11(4) 3^4.5 (0.00s)'],
        'b0: 2^4 3^4.7');

    # The candidates below are not solutions, which recovery cannot know:
    # each is the one value that gives the line that property.

    # 2^17 at v_0 allows nothing less than the candidate.
    expect_recover_next_batch(
        q{recover beneath a batch whose least is the candidate},
        [qw{ -x1e20 36 5 }],
        ['202 Candidate 131072 (0.00s)',
         '305 b39: 2^17 3^8 2 . 2^2.3 (0.00s)'],
        'b40: 2^3.3^2 . 2 3 2^2');

    # 19^2 at v_1 is within its limit only while the candidate is in range.
    my $line = '305 b0: 2^5.3 19^2 2 3.2309^2 2^2 (0.00s)';
    expect_recover(q{recover beneath a prime the candidate puts out of reach},
        [qw{ -x1e12 24 5 }],
        ['202 Candidate 138984 (0.00s)', $line],
        'b0: 2^5.3 5^5 2 3 2^2');
    expect_recover_fail(q{but not if the candidate was never beneath it},
        [qw{ -x1e12 24 5 }],
        ['202 Candidate 138983 (0.00s)', $line],
        qr{^prep_nextt});
}

sub test_batch_id_64bit {
    # batch ids are 64-bit
    local $type = 'o';

    expect_recover_next_batch(
        q{batch numbering passes 2^32},
        [qw{ -x1e12 12 4 }], ['305 b4294967295: 3 2^2 . 2.3'],
        'b4294967296: 3 2^2 . 2.3^2',
    );
}

sub test_recover_j0123 {
    # -j0..-j3 are easy to recover
    local $type = 'o';
    my $args124 = [qw{ -x1e10 -f3 12 4 }];

    for my $j (0, 1, 3) {
        expect_recover(qq{recover -j$j}, [ "-j$j", @$args124 ],
            ['305 b0: 2^2.3 5^2 2 3.31^2: 29 / 228'],
            'b0: 2^2.3 5^2 2 3.31^2: 29 / 17342',
        );
    }
    expect_recover(q{recover -j2}, [ '-j2', @$args124 ],
        ['305 b0: 2^2.3 . 2 3.43^2: 4 / 133'],
        'b0: 2^2.3 . 2 3.43^2: 4 / 225346',
    );
}

sub test_6x {
    # STRATEGY_6X: allocation patterns like "...2^{4+} . 2z^2..." trigger
    # a strategy switch taking advantage of the maths to restrict to a much
    # smaller search space.
    #
    # In the tests we must set gain (-g) high enough to avoid being diverted
    # to a full walk_v() sweep for the small -x values we test.
    local $type = 'o';

    # -x must be at least 19600, the residue of 2^4.5^2 . 2.3^4

    expect_diag(q{6x pattern is identified and applied, 30 4}, 4,
        [qw{ -g1000 -x20000 -jp -b2 30 4 }],
        'b2: 2^4.5^2 . 2.3^4 . 6X(13,0,4)',
    );
    expect_recurse_count(q{6x search is exhaustively correct, 30 4}, 5,
        [qw{ -g1000 -x20000 -jp -b2 30 4 }]);

    expect_diag(q{6x pattern is identified and applied, 90 4}, 4,
        [q{-I"2^4 . 2 ."}, qw{ -g1000 -x142838800 -f2 -jp -b4 90 4 }],
        'b4: 2^4.5^2.7^2 . 2.3^4 . 6X(613,0,12)',
    );
    expect_recurse_count(q{6x search is exhaustively correct, 90 4}, 59,
        [q{-I"2^4 . 2 ."}, qw{ -g1000 -x142838800 -f2 -jp -b4 90 4 }]);
}

sub test_recover_6x {
    # STRATEGY_6X recovery: a "6X(p,vi,a)" diag line (see above) must be
    # enough to resume best_6x()'s own search loop exactly where it left
    # off - including re-trying 'a' itself (hitting both of its walk_1()
    # branches unconditionally, by design; see best_6x()'s own comment),
    # then continuing on to whatever the search does next.
    #
    # Since recovery does not re-explore already-completed ancestor
    # branches above the recorded point, a recovered run's recurse count
    # is necessarily lower than the equivalent cold run's - the expected
    # counts here were found the same way as the plain-run counts above:
    # by comparing against the -dW trace at the recorded point.
    local $type = 'o';

    expect_recover_recurse_count(q{recover 6x from its own diag point, 30 4},
        1, ['305 b2: 2^4.5^2 . 2.3^4 . 6X(13,0,4)'],
        [qw{ -g1000 -x20000 -jp -b2 30 4 }]);

    expect_recover_recurse_count(q{recover 6x from its own diag point, 90 4},
        55, ['305 b4: 2^4.5^2.7^2 . 2.3^4 . 6X(613,0,12)'],
        [q{-I"2^4 . 2 ."}, qw{ -g1000 -x142838800 -f2 -jp -b4 90 4 }]);

    # A trailing candidate can leave no room for a level above the 6X
    # search, here 659^2 at v_0: the search must move on from that level,
    # not resume beneath it.
    expect_recover(q{recover 6x with a trailing candidate that ends a level},
        [qw{ -g1000 -jp -x1e13 30 4 }],
        ['305 b2: 2^4.659^2 . 2.3^4 . 6X(868561,0,6)',
         '202 Candidate 1000000000000 (0.00s)'],
        'b2: 2^4.5^5 . 2.3^4 .');
}

sub test_flip {
    # run_flip_pqsq(): when a p^z allocation is too high to leave any
    # (z,z,2) partitions, we deallocate it and instead exhaustively try
    # (2z,z) partitions directly (see its own comment for the maths).
    local $type = 'o';

    expect_diag(q{flip is identified and applied, 36 4}, 80,
        [qw{ -j2 -x1e6 -b7 36 4 }],
        'b7: 2^2.5^2 . 2.11^5 . F(2,23)',
    );

    # Under -j4 there is more than p^7.q^3 left to try once p^3.q^3.r is
    # out of reach: a flip at 37^3 here would miss 61^3.67.71.73. Recovery
    # is used only to start close to that point.
    expect_recover_result(q{-j4 does not flip at p^3},
        78821649041, ['305 b0: 37^3'],
        [qw{ -j4 -g100 -x78821649040:78821709041 32 1 }]);

    expect_recover_recurse_count(q{recover flip from its own diag point, 36 4},
        128, ['305 b7: 2^2.5^2 . 2.11^5 . F(2,23)'],
        [qw{ -j2 -x1e6 -b7 36 4 }]);

    # A candidate logged after the last 305 line lowers zmax enough that
    # the flip allocation would overflow: it is applied after that. It
    # leaves the flip nothing that fits, so we see the next power at v_2.
    expect_recover(q{recover flip with trailing candidate},
        [qw{ -j2 -x1e12 36 4 }],
        [q{305 b6: 2^2.3.31^2 . 2.7^5.5443^2 3^8 F(2,587)},
         q{202 Candidate 460546327700 (70.18s)}],
        q{b6: 2^2.3.31^2 . 2.5^8 3^8});

    # This one leaves no room for 83^2 at v_0, above the flip, so we see
    # the next power there.
    expect_recover(q{recover flip with a trailing candidate that ends a level},
        [qw{ -j2 -x1e10 36 3 }],
        [q{305 b0: 2^2.83^2 . 2.3^5.251^2 F(2,89)},
         q{202 Candidate 400001 (0.00s)}],
        q{b0: 2^2.3^5 . 2});

    # From a real log: recovery carries on to the line the run wrote next.
    expect_recover(q{recover with trailing candidate, 36 3},
        [qw{ -j2 -x1000000000:3000000000 36 3 }],
        [q{202 Candidate 1913700348 (0.01s)},
         q{305 b0: 2^2.3^2 . 2.5^2.1877^2: 0 / 0 (0.01s) [815 398 311]},
         q{202 Candidate 1233095148 (0.01s)}],
        q{b0: 2^2.3^2 . 2.5^2.29^5});

    # From a real log: 97 is the last prime to try here, so the flip is
    # done and the search moves to the next power at v_2.
    expect_recover(q{recover flip to its end, after a candidate},
        [qw{ -j2 -x1e10 36 3 }],
        [q{202 Candidate 323660348 (0.05s)},
         q{305 b0: 2^2.109^2 . 2.7^5.97^2 F(2,89)}],
        q{b0: 2^2.109^2 . 2.3^8}, 3);

    # A candidate found during a flip need not leave room for the
    # allocation the flip replaced, here 23^2 at v_2: recovery reapplies
    # that only to rebuild its level. The flip then has nothing left to
    # try, and the search moves to the next power at v_2.
    expect_recover(q{recover flip when a candidate rules out what it replaced},
        [qw{ -j2 -x1e6 36 4 }],
        [q{202 Candidate 333333 (0.00s)},
         q{305 b7: 2^2.37^2 . 2.3^5.41^2 . F(2,23)}],
        q{b7: 2^2.37^2 . 2.3^8 .});

    # An edited line, which the run could not have written: 11^5 cannot be
    # applied at v_0. The flip moves on to 17^5, and beneath that it must
    # start again from 41, not from the 53 that was recovered.
    expect_recover(q{only the recovered prime resumes inside a flip},
        [qw{ -x1e14 54 2 }],
        [q{305 b0: 2^2.11^5.53^2 3^2.7^2 F(0,41)}],
        q{b0: 2^2.17^5.41^2 3^2.7^2 F(0,41)}, 2);

    # there can be unforced allocations before the flip set
    expect_recover(q{recover flip past prior allocations to the same v_i},
        [qw{ -x103148643381388141823 -j2 -f3 -g20 324 3 }],
        ['305 b0: 2^2.3^2.5^2.7^2 . 2.11^2.13^2.79^5 F(2,3491)'],
        'b0: 2^2.3^2.5^2.7^2 . 2.11^2.13^2.79^5 F(2,3491)');

    # From a real log: the flip need not be at a prime power. This one is
    # done once it has tried 5^5 beneath 2^11, so the search moves to the
    # next power at v_1.
    expect_recover(q{recover flip at a composite power, 72 2},
        [qw{ -x1e12 72 2 }],
        [q{202 Candidate 6481475 (0.02s)},
         q{305 b0: 3^5 2^11.5^5 F(1,5)}],
        q{b0: 3^5 2^8}, 3);

    # A line that -j4 could write when it still flipped at p^3: that run
    # may already have missed values.
    expect_recover_fail(q{refuse to recover a flip at p^3 under -j4},
        [qw{ -j4 -x1e12 32 2 }],
        [q{202 Candidate 58695 (0.01s)},
         q{305 b*: 3 2^7 F(1,5)}],
        qr{^failed to inject flip});
}

sub test_recover_j4 {
    # -j4 and -js can allocated power p^{2^x-1}, a more complex pathway
    # that has more recover paths to consider.
    # For each testcase where they are relevant, these tests should show:
    # a) that recovered allocations are in the correct recurse order;
    # b) that internal t_allocation.lim values are correctly recalculated;
    # c) that the best recovered candidate is correctly recorded.
    local $type = 'o';
    my $args124j4 = [qw{ -j4 -x1e10 -f3 12 4 }];

    expect_recover(q{recover -j4 from expanded line},
        $args124j4,
        ['315 b0: 2^2(1).3(2) 5^2(3) 2.13^2 3.7^2(4) (0.00s) [34 2 0 1]'],
        'b0: 2^2.3 5^2 2.13^2 3.7^2: 0 / 2012',
    );

    # a candidate found after the last logged progress line must not
    # tighten the search bound until after the recorded position has
    # been fully replayed - doing it first would make the now-smaller
    # bound disagree with the order recorded under the original, larger
    # one.
    expect_recover(q{recover -j4 trailing candidate after expanded line},
        $args124j4,
        ['315 b0: 2^2(1).3(2) 5^2(3) 2.13^2 3.7^2(4) (0.00s) [34 2 0 1]',
         '202 Candidate 185622924 (0.00s)'],
        'b0: 2^2.3 5^2 2.13^2 3.7^2: 0 / 37',
    );

    # if the search backtracks (here, past the forced primes entirely -
    # the batch id changes from b0 to b1) after the last "315" line was
    # written, its recorded order is stale; recovery must fall back to
    # the following "305" line's own genuine data rather than silently
    # trusting the outdated order.
    expect_recover(q{recover -j4 expanded order superseded by backtrack},
        $args124j4,
        ['315 b0: 2^2(1).3(2) 5^2(3) 2.13^2 3.7^2(4) (0.00s) [34 2 0 1]',
         '305 b1: 2^2 3^2 2.11^2 5^2: 3 / 8 (0.02s) [2661 279 207 4]'],
        'b1: 2^2 3^2 2.11^2 5^2: 3 / 45912',
    );

    # With n = 64 every tau is a power of 2, so all of best_v4()'s choices
    # depend on zmax. Here the candidates found since the choice of v_1 at
    # level 5 would make best_v() choose differently on recovery, so the
    # 315 line marks that level alone.
    expect_recover(q{recover -j4 from a level marked after candidates},
        [qw{ -j4 -x1e15 64 3 }],
        ['202 Candidate 2260515199304 (0.00s)',
         '202 Candidate 409736749784 (0.00s)',
         '202 Candidate 157156822184 (0.00s)',
         '202 Candidate 41769309944 (0.00s)',
         '202 Candidate 3824122664 (0.00s)',
         '202 Candidate 2931871304 (0.01s)',
         '202 Candidate 220522664 (0.01s)',
         '202 Candidate 167663144 (0.01s)',
         '315 b0: 2^3 3.5.29(5).47.71.79 2.7 (0.02s) [1394 458 49]'],
        'b0: 2^3 3.5.29.47.71.79 2.7',
    );

    # A run stopped just after finding a candidate: the 315 line it wrote
    # there must mark the level whose position the candidate changes. We
    # start it close by, with the bound it had reached.
    expect_recover_after_candidate(
        q{recover -j4 from a line written after a candidate},
        [qw{ -j4 -x2931871303 64 3 }],
        ['305 b0: 2^3.19 3.5.11 2.7.13.23: 2 / 27'],
        'b0: 2^3.19 3.5.11 2.7.13.29: 0 / 1',
    );

    # Under -X candidates are reported in no particular order; the least
    # must survive recovery.
    expect_recover_result(q{recover -j4 -X keeps the least candidate},
        19940,
        ['202 Candidate 19940 (0.01s)',
         '202 Candidate 1873924 (0.02s)',
         '305 b4: 2^2 5^2 2.3^2 11^2: 9 / 13 (0.02s) [2792 491 51 5]'],
        [qw{ -j4 -X -x3e6 -f3 12 4 }]);

    # -js (a fixed, user-specified allocation order) can also produce
    # "315" lines, but its own choices don't depend on the search bound
    # the way -j4's do, so a plain "305" line is enough to confirm its
    # recovery works.
    expect_recover(q{recover -js},
        [ '-js1,3', @{[ qw{ -x1e10 -f3 12 4 } ]} ],
        ['305 b0: 2^2.3 5^2 2 3.7^2: 94 / 340135'],
        'b0: 2^2.3 5^2 2 3.7^2: 94 / 340135',
    );
}

sub test_recover_failed_apply {
