#!/usr/bin/env perl
BEGIN { do "./lib/reexec" for grep $_, $ENV{MATHPERL} }
use strict;
use warnings;
use lib 'lib';
use Math::Prime::Util qw{ divisors };
use H::Diag qw{ diag keep_diag };

=head1 multibench-table: tabulate this machine's costs for pcoul

  multibench-table [-v<verbose>] [-m<mock>] [-b<bits,...>] [-f<flake>]
          [-s<sections> | -o | -M] [-u<table>] [-w<file>]

Writes to stdout, or to I<file> with C<-w> (when progress is shown on
stdout as runs done / total), the cost table that pcoul's cost model
(F<coulcost.c>) works from, so that the model carries no costs of its
own: one table per machine and MPUGMP build, serving runs for any n.
pcoul reads it from C<$COST_TABLE>, or as the file F<timings> has it
built in. Times in the table are in microseconds, in the unit pcoul
reports times in: where it can open the cycle counter (see C<-Lc>),
cycles at its reference clock rate (by default 3.6GHz), so that the
table does not depend on the turbo clock while it is made; else CPU
seconds. It needs two builds of pcoul, given by C<-v> (C<VERBOSE=1>,
default F<./pcoul>), which runs the benches and the instrumented
calibration runs, and C<-m> (C<MOCK=1>), with which the sections leaf
and tail are timed.
The table is in sections (scan, prime, multi, ladder, qs, walk, w1s,
leaf, tail, situ), each stamped with the build that made it and the
unit of its times ("V section sha CY3.6", or CPU). C<-s> makes only the
sections named, and C<-u> copies the rest from an existing table (with
a warning for any timed in a different unit).

The model costs the trial division stage of each test itself, since
how often the values a walk tests are divisible by each trial prime
depends strongly on the walk. So the benches first find the trial
division limit L for each size (it changes at 80 bits in some builds),
the cost of a test that fails at each of a range of trial primes, and
the extra cost of a factor found there that does not end the test, at
sizes either side of the limb boundaries at 64 and 128 bits, since the
costs step up with each limb (the model uses the nearest size with as
many limbs), giving lines:

  S bits p prep_us prime_us [extra_us]
  L bits L

Then for each size in the bits grid, it feeds test_multi_append()
random integers with no factor up to L, giving one line per case:

  t e bits F rej dec pend pass prep_us run_us

where F is that L, t the tau sought and e the exponent multiplier (1
for a need_other value, more for the root of a fixed power). After
trial division, what tau_multi_prep() does depends on t and e only
through their class (see cm_tclass() in F<coulcost.c>), so there is a
row for each class: t = 4, e = 1 (prime and power tests, then left
pending unless prime); t = 3, e = 1 (the same tests, then rejected);
and t = 3, e = 2 (a prime test decides it). The model takes each test
for tau t, e from the row of its class, and what the ladder does with a
pending value from the G rows below, which derive the effect of t. The
fractions are of inputs rejected in prep, fully decided in prep, and
left pending for the ladder; I<pass> is the fraction of pending inputs
the ladder accepts; the times are mean prep time per input and mean
ladder time per pending input. A table made by an earlier version has
rows for each divisor t > 2 of its n instead: the model takes a row for
the exact t and e where it has one, else one of the same class. C<-o>
skips these lines; C<-M> gives only these lines.

Then the remaining costs:

  P bits F pass us  a prime test of a value with no factor up to F = L
  R bits us us      the primality test prep makes when only a prime is
                    left to find, on the same inputs and on composites
  S, L              as above
  C linsetup us     linear walk, per walk
  C linsetupinv us  linear walk, per inverse-filter entry set up
  C loop0 us        linear walk, per ati
  C looptest us     linear walk, per inverse-filter entry tested
  C sqsetup us      fixed-power walk, per walk
  C sqsetupres us   fixed-power walk, per root residue (sorted each walk)
  C sqloop0 us      fixed-power walk, per root
  C sqtest us       fixed-power walk, per inverse-filter entry tested
  C cprime us       innermost recurse loop, per prime
  C cprimesq us     likewise, for loops walking a fixed power
  C w1scall us      walk_1_set(), per call
  C w1siter us      walk_1_set(), per prime
  C w1scheck us     walk_1_set(), per prime passing the check mod aq/q_i
  C ctail us        recurse loop, per prime in the stubbed end of a
                    loop whose primes are almost all rejected on rq > zmax
  K name us         the cost of a step of a test's preparation, found
                    in situ (see below)
  G bits rung reach us hit fbits cprime
                    the factoring ladder of tau_multi_run()
  G bits 0 none     likewise, the fraction for which it found no factor

The walk loop costs are fitted by least squares, weighting each walk
by the inverse of its cost, to the walks of calibration runs with the
C<-v> pcoul at C<-dv6>: for linear walks, one with long walks, one cut
short with C<-Ld> whose walks set up many more inverse-filter entries,
and one with long walks testing more of them per iteration; for those
under a fixed power, one, and one cut short whose walks sort many more
root residues. Each is fitted from the time outside the tests, less the
instrumentation's own clock reads at the cost a bench finds for one,
against the entries set up (linear) or the residues (fixed power), the
iterations, and the expected inverse entries tested. How well the fit
describes each run, and what each cost would be without it, are
reported, since each run is there for walks of a shape that pcoul's
choices may cease to give it. The walk_1_set() costs are fitted
likewise to its calls in the first run under a fixed power, in one run
making a single call over millions of primes that all reach the tests,
and in one cut short making many calls of the size real runs make,
against the calls, the primes, and those passing the check mod aq/q_i.

C<cprime> and C<cprimesq> are each found by timing a calibration batch
with the mock pcoul, once with leaf loops stubbed and once with them run
for real: the difference in real (unmocked) time over the number of
primes stubbed. In loops walking a fixed power only the primes that pass
the early rejections (reject_square() and the like) are stubbed, so that
difference is the extra each costs over C<cprime>, as pcoul counts it,
and C<cprimesq> is C<cprime> plus it. C<ctail> likewise, from a batch
of D(162, 3) deep enough that almost every prime its recursion tries is
rejected on rq > zmax, timed with the ends of such loops stubbed and run
(and leaf loops run for real in both, so that none of those primes is
strided).

The K rows (section situ) price each test's preparation by what it
did, for the costs -ja counts: for tau_multi_prep(), per call
(prepcall), per trial prime tested by limbs (prepstep1..3, 3 for 3 or
more), per gcd by trial band (prepgcd0..4), per bit of the values
tested for primality (preppbit for those of a single limb, which are
tested in single limbs, prepzbit for the rest) and per power test
(preppower); for tau_prime_prep(), by its result <r>, per call for
values of up to 16 bits (pprep<r>small), and for larger values per call
at 16 bits (pprep<r>at16), per bit beyond (pprep<r>bit) and for a
second limb (pprep<r>limb), each only where there were values to fit
it to. They are fitted, by least squares weighting each by the inverse
of its cost, with no negative costs, to 1 in 32 of the preparations (1
in 320 for prime tests) in calibration runs of the C<-v> pcoul at
C<-ja1 -dv16>, each timed alone with the gap between two clock reads
taken off: timed in the full program, they see its caches and branch
history as the benches cannot.

The G rows come from running the ladder on random composites of the
given size with no factor up to L, each alone and stopping at the
first factor found: per rung, the fraction of inputs reaching it, the
mean cost of an attempt there (including splitting a composite factor
found), the fraction of attempts finding a factor, and for those the
mean size of the prime factor and the fraction whose cofactor is prime.
From 100 bits the inputs are instead built from their factors, the
smallest from the distribution Buchstab's function gives (for
integers with no factor below L) with probability 0.3, else uniformly
in log, each weighted by the ratio of the densities: the same expected
results, with many more of the inputs that alone reach the costly high
rungs. (At 72 bits, where both can be run at length, built and random
inputs agree to within sampling error.) Above 255 bits there are no G
rows unless C<-f> is given; the model uses the largest.

QS always finds a factor, at a cost set by the size alone but large
(12s at 207 bits, 39s at 223, 387s at 255), so it runs on only the
first built input that reaches it at each size, the rest charged the
same and credited with the input's smallest factor. Sizes run up to
255 bits (60 inputs each above 191). The model takes the cost of QS
instead from rows

  Q bits us fail

timing QS alone on a few products of two primes of half the size (5
below 200 bits, 2 below 230, then 1), every 3 bits from 100 to 262 (or
the flake size), since its parameters (see _GMP_simpqs()) step with
each decimal digit. Without C<-f> the QS and ladder rows above 230 bits
take over an hour here.

With C<-f>I<flake>, the table is for runs with C<-o>I<flake>: the ladder
is benched under the same option, which drops the rungs from QS on for
values above I<flake> bits (the failure handler then logs what is left,
to be factored separately), and sizes above I<flake> are added up to
511 (30 inputs at 277-299, 12 above: each input's costliest rung is then
a single ECM rung, 31s per attempt at 299 bits and more above, so these
are rough). The model also drops those rungs itself under C<-o>, but
can only price the sizes the table has.

None of these depends on what the value is being tested for, so the
model derives the effect of a factor found on a test for tau(n^e) = t,
including restarting the ladder on the cofactor, and interleaves the
pending values of a call as tau_multi_run() does. The sizes are the
ends and some interior points of the size brackets in tmfb[] in
F<coultau.c>, which choose the rungs used, up to 255 bits (511 with -f).

=cut

my($verbose, $mock, $outfile, $flake, $update)
        = ('./pcoul', undef, undef, 0, undef);
my @sections = qw{ scan prime multi ladder qs walk w1s leaf tail situ };
my %want = map +($_ => 1), @sections;
# (with sizes either side of the limb boundaries at 64 and 128 bits,
# where costs step up)
my @bits = (16, 20, 24, 28, 32, 36, 40, 44, 48, 52, 56, 60, 64, 65, 72, 80,
        96, 112, 128, 129);
while (@ARGV && $ARGV[0] =~ /^-/) {
    my $arg = shift @ARGV;
    last if $arg eq '--';
    $verbose = $1, next if $arg =~ /^-v(.+)$/;
    $mock = $1, next if $arg =~ /^-m(.+)$/;
    @bits = split(/,/, $1), next if $arg =~ /^-b([\d,]+)$/;
    $flake = $1, next if $arg =~ /^-f(\d+)$/;
    $outfile = $1, next if $arg =~ /^-w(.+)$/;
    $update = $1, next if $arg =~ /^-u(.+)$/;
    if ($arg =~ /^-s([\w,]+)$/) {
        my @s = split /,/, $1;
        for (@s) {
            my $s = $_;
            grep $_ eq $s, @sections or die "Unknown section '$s'";
        }
        %want = map +($_ => 1), @s;
        next;
    }
    if ($arg eq '-o') {
        %want = map +($_ => 1), grep $_ ne 'multi', @sections;
        next;
    }
    if ($arg eq '-M') {
        %want = (multi => 1);
        next;
    }
    die "Unknown option '$arg'";
}
my $need_mock = grep $want{$_}, qw{ leaf tail };
@ARGV == 0 && ($mock || !$need_mock)
        or die "500 Usage: $0 [-v<verbose>] [-m<mock>] [-b<bits,...>]"
                . " [-f<flake>] [-s<sections> | -o | -M] [-u<table>]"
                . " [-w<file>]";
# The benches run in a pcoul for this n and k, which serve for every n:
# n needs the divisors the benches test for (3 and 4 for the test_multi()
# rows, 4 and 6 for the scan rows).
my($n, $k) = (12, 2);

# with -u, the existing table: its lines by section
my %old;
if (defined $update) {
    open my $fh, '<', $update or die "$update: $!";
    while (<$fh>) {
        chomp;
        my $sec = section_of($_) or next;
        push @{ $old{$sec} }, $_;
    }
    close $fh;
}

my $out = \*STDOUT;
if (defined $outfile) {
    open(my $fh, '>', $outfile) or die "$outfile: $!";
    $fh->autoflush(1);
    $out = $fh;
    # Progress is shown on one line, erased and rewritten by the next:
    # a warning or death printed after it starts on a line of its own,
    # lest the next progress line erase it too.
    $SIG{__WARN__} = sub { keep_diag(); warn @_ };
    $SIG{__DIE__} = sub { keep_diag() };
}

# calibration runs: walks under a fixed power (nqc == 1), linear walks,
# and a batch rich in leaf loops
my @cal_sq = ('-x1e17', 18, 4);
my @cal_lin = ('-j4', '-f5', '-g24', '-x393643805345636319',
        '-I2^2.3 . 2.5^5 3 2^7 . 2.3^5 5', '-b8', 96, 8);
# and walks of each kind with more to set up, cut short: linear ones
# with 19 inverse-filter entries, and those under a fixed power with 32
# to 256 root residues. The linear run spends its first 8 to 11s (CPU
# seconds, or cycles at 3.6GHz, on the machines tried) in walks whose
# time goes on test_multi(), so its limit leaves room for the short
# walks that follow.
my @cal_lin2 = ('-j4', '-Ld30', '-x1e30', 512, 4);
# and long linear walks with about 7.5 entries tested per iteration, as
# against about 3.2 in 96 8: in so narrow a range the gain gate walks a
# level higher
my @cal_lin3 = ('-j4', '-Ld20', '-x5e29:6e29', 512, 4);
my @cal_sq2 = ('-j4', '-Ld2', '-x1e30', 13122, 4);
my @cal_leaf = @cal_lin;
# and one rich in leaf loops walking a fixed power whose primes pass the
# early rejections (see cprime()): -js and -I pin the route that -ja1 -ka
# takes in D(36,7) to a loop of p^2 at v_2 below the square at v_6, with
# -p keeping p^2 under its greatest root, so that about half pass
my @cal_leafsq = ('-js2', '-g1e6', '-p8000000',
        '-x999000000000000000000000000000:1000000000000000000000000000000',
        '-I2^5.3^2 5.7^2 2 3 2^2 43^2 2.3.5^2', 36, 7);
# walk_1_set() with every prime reaching the tests
my @cal_w1s = ('-f3', '-j2', '-g16', '-x1e16:1e17', '-b3', 18, 4);
# and many walk_1_set() calls of a size typical of real runs (those of
# D(48,10)), almost all of whose primes fail the check mod aq / q_i: the
# first 114 or so try about 157 primes each, then come calls of 5, so its
# limit leaves room for both, to tell the cost per call from per prime
my @cal_w1s2 = ('-j2', '-f7', '-g30', '-Ld40', '-x22911293821947932', 48, 10);
# deep recursion where almost every prime fails on rq > zmax
my @cal_tail = ('-j2', '-f3', '-g60', '-x3068295382408046177023',
        '-I3^2.5^2.7^2.397^2 2^2 .', 162, 3);

# runs whose test preparations price them in situ: small and large
# values, linear and fixed-power walks, the last two with values of two
# limbs
my @cal_situ = (\@cal_lin, \@cal_sq, [ '-j4', '-x1e10', 36, 5 ],
        [ '-j2', '-x1e15', 60, 4 ], \@cal_tail,
        [ '-j2', '-x1e22', 36, 5 ]);

my $tmp = "/tmp/multibench-table.$$";
$| = 1;

# The build and the unit of times: pcoul times work in cycles at a
# reference clock rate when it can open the cycle counter, so that the
# table does not depend on the turbo clock while it is made; without the
# counter, times are CPU seconds at whatever clock the machine ran.
my($sha, $clock) = build_sha($verbose);
if ($need_mock) {
    my(undef, $mclock) = build_sha($mock);
    $mclock eq $clock
            or die "$verbose times in $clock, but $mock in $mclock";
}
warn "multibench-table: no cycle counter, times will be CPU seconds,"
        . " which vary with the turbo clock\n" if $clock eq 'CPU';

# the test_multi() rows: one (t, e) of each class that makes a test
# (see cm_tclass() in coulcost.c)
my @te = ([ 4, 1 ], [ 3, 1 ], [ 3, 2 ]);

# sizes for trial division (the model takes its costs from the nearest
# with as many limbs)
my @scan_bits = (24, 40, 56, 64, 72, 80, 81, 128, 136);
my @prime_bits = (16, 18, 20, 21, 22, 24, 28, 32, 40, 48, 56, 64, 65, 72,
        80, 96, 112, 128, 129);
# the ladder: the size brackets of tmfb[] in coultau.c end at 53, 58, 63,
# 64, 72, 77, 89, 99, 126, 127, 159, 191; at 32 bits there are too few
# composites with no factor up to 64007 to find
my @ladder_bits = (36, 40, 44, 48, 52, 53, 56, 58, 60, 63, 64, 68, 72, 76,
        77, 80, 84, 88, 89, 92, 96, 99, 104, 112, 120, 126, 127, 136, 144,
        152, 159, 176, 191, 207, 223, 239, 255);
# with -f, sizes where QS is not used: the larger brackets end at 299, 511
push @ladder_bits, grep $_ > $flake, (277, 299, 400, 511) if $flake;
# QS alone, every 3 bits (about each decimal digit, by which its
# parameters step) from where the ladder first uses it, to 262 bits
# or the flake size
my @qs_bits = grep !$flake || $_ <= $flake, map 100 + 3 * $_, 0 .. 54;
# the progress total: the pcoul runs to make
my($done, $total) = (0, 0);
$total += @scan_bits if $want{scan};
$total += @te * @bits if $want{multi};
$total += @prime_bits if $want{prime};
$total += @ladder_bits if $want{ladder};
$total += @qs_bits if $want{qs};
$total += 2 if $want{walk} || $want{w1s};   # the clock bench and 18 4
$total += 4 if $want{walk};     # three more walk runs
$total += 2 if $want{w1s};
$total += 12 if $want{leaf};
$total += 6 if $want{tail};
$total += @cal_situ if $want{situ};

# the lines built, by section
my %new;

# Trial division: its limit L by size, and the cost of failing at each
# trial prime, at a range of sizes including those around 80 bits, where
# the limit changes. The test_multi() and prime test rows are for inputs
# with no trial factor, so each uses the L for its size.
# (an even t, since for odd t prep first checks for a square)
my $tscan = (grep $_ > 2 && !($_ & 1), divisors($n))[0] // 2;
# and an even t whose half is not 2, for the extra cost of a factor that
# does not end prep
my $tx = (grep $_ >= 6 && !($_ & 1), divisors($n))[0];
$new{scan} = [ map bench("scan,$_,2000,$tscan" . ($tx ? ",$tx" : '')),
        @scan_bits ] if $want{scan};
my %L = map { /^L (\d+) (\d+)/ ? ($1 => $2) : () } lines_of('scan');
%L or !grep($want{$_}, qw{ multi prime ladder })
        or die "need the trial division limits: add -sscan, or -u a table";
sub trial_limit {
    my($bits) = @_;
    my($near) = sort { abs($a - $bits) <=> abs($b - $bits) } keys %L;
    return $L{$near};
}

if ($want{multi}) {
    for my $te (@te) {
        my($t, $e) = @$te;
        for my $b (@bits) {
            my $count = ($b <= 64) ? 5000 : ($b <= 80) ? 2000 : 500;
            my $F = trial_limit($b);
            my($line) = grep /^MULTIBENCH /, bench("$b,$t,$count,$F,1,$e");
            my @v = ($line // '') =~ m{
                fail\ ([\d.]+)\ decided\ ([\d.]+)\ pending\ ([\d.]+)
                \ \(pass\ ([\d.]+)\);\ prep\ ([\d.]+)us .* run\ ([\d.]+)us
            }x or die "no result for t=$t bits=$b";
            push @{ $new{multi} }, join(' ', $t, $e, $b, $F, @v);
        }
    }
}
if ($want{prime}) {
    for my $b (@prime_bits) {
        push @{ $new{prime} }, grep /^[PR] /,
                bench("prime,$b,20000," . trial_limit($b));
    }
}
if ($want{ladder}) {
    for my $b (@ladder_bits) {
        my $count = ($b <= 64) ? 3000 : ($b <= 99) ? 1500
                : ($b <= 159) ? 400 : 150;
        # from 100 bits, inputs built with their smallest factor
        # oversampled at large sizes, for the rare costly rungs
        my $alpha = ($b < 100) ? '' : ',0.3';
        $count = ($b <= 255) ? 60 : ($b <= 299) ? 30 : 12 if $b > 191;
        push @{ $new{ladder} }, grep /^G /,
                bench("ladder,$b,$count," . trial_limit($b) . $alpha,
                        $flake ? "-o$flake" : ());
    }
}
if ($want{qs}) {
    for my $b (@qs_bits) {
        my $count = ($b < 200) ? 5 : ($b < 230) ? 2 : 1;
        push @{ $new{qs} }, grep /^Q /, bench("qs,$b,$count");
    }
}
my @log_sq = ($want{walk} || $want{w1s}) ? gate_log(@cal_sq) : ();
my $read = ($want{walk} || $want{w1s}) ? clock_read() : 0;
if ($want{walk}) {
    my @lin = fit_walks('N', $read,
            map([ $_, gate_log(@$_) ], \@cal_lin, \@cal_lin2, \@cal_lin3));
    my @sq = fit_walks('S', $read, [ \@cal_sq, @log_sq ],
            [ \@cal_sq2, gate_log(@cal_sq2) ]);
    $new{walk} = [
        sprintf('C linsetup %.4f', $lin[0]),
        sprintf('C linsetupinv %.5f', $lin[1]),
        sprintf('C loop0 %.5f', $lin[2]),
        sprintf('C looptest %.5f', $lin[3]),
        sprintf('C sqsetup %.4f', $sq[0]),
        sprintf('C sqsetupres %.5f', $sq[1]),
        sprintf('C sqloop0 %.5f', $sq[2]),
        sprintf('C sqtest %.5f', $sq[3]),
    ];
}
if ($want{w1s}) {
    my @w1s = fit_w1s($read, [ \@cal_sq, @log_sq ],
            map([ $_, gate_log(@$_) ], \@cal_w1s, \@cal_w1s2));
    $new{w1s} = [
        sprintf('C w1scall %.4f', $w1s[0]),
        sprintf('C w1siter %.5f', $w1s[1]),
        sprintf('C w1scheck %.5f', $w1s[2]),
    ];
}
if ($want{leaf}) {
    my $c = cprime('leaf', @cal_leaf);
    # what a prime passing the early rejections costs over that
    my $csq = $c + cprime('sq', @cal_leafsq);
    $new{leaf} = [ sprintf('C cprime %.4f', $c),
            sprintf('C cprimesq %.4f', $csq) ];
}
$new{tail} = [ sprintf('C ctail %.4f', cprime('tail', @cal_tail)) ]
        if $want{tail};
$new{situ} = [ fit_prep(@cal_situ) ] if $want{situ};

# each section rebuilt is marked with the build that made it, and the
# unit of its times
my %ver = map { /^V (\w+) / ? ($1 => $_) : () } lines_of('V');
$ver{$_} = "V $_ $sha $clock" for grep $want{$_}, @sections;
for my $sec (grep !$want{$_} && $ver{$_}, @sections) {
    my($c) = $ver{$sec} =~ /^V \S+ \S+ (\S+)/;
    $c //= 'CPU';
    warn "multibench-table: section $sec kept is timed in $c, not $clock\n"
            if $c ne $clock;
}
print $out "$ver{$_}\n" for grep $ver{$_}, @sections;
print $out "$_\n" for map lines_of($_), @sections;
finish();

# The lines of a section: as built now, else from the table updated.
sub lines_of {
    my($sec) = @_;
    return @{ $new{$sec} // $old{$sec} // [] };
}

# the section of a table line, if it has one
sub section_of {
    local($_) = @_;
    return /^V / ? 'V'
        : /^\d/ ? 'multi'
        : /^[SL] / ? 'scan'
        : /^[PR] / ? 'prime'
        : /^G / ? 'ladder'
        : /^Q / ? 'qs'
        : /^C (?:linsetup|loop0|looptest|sqsetup|sqloop0|sqtest) / ? 'walk'
        : /^C w1s/ ? 'w1s'
        : /^C cprime/ ? 'leaf'
        : /^C ctail / ? 'tail'
        : /^K / ? 'situ'
        : undef;
}

# The build of a pcoul, as its 001 line gives it, and the unit of its
# times: CY<GHz> for cycles at that clock rate, else CPU for CPU seconds.
sub build_sha {
    my($pcoul) = @_;
    my $out = `'$pcoul' -x1 6 2 2>&1`;
    my($sha) = $out =~ /^001 .* sha=(\S+)/m
            or die "no sha in the 001 line from $pcoul";
    my($ghz) = $out =~ /^001 .*\*CY([\d.]+)\*/m;
    return ($sha, defined($ghz) ? "CY$ghz" : 'CPU');
}

sub finish {
    keep_diag() if defined $outfile;
    close $out if defined $outfile;
    unlink $tmp;
    exit 0;
}

# count a pcoul run, showing progress when writing to a file
sub progress {
    my($what) = @_;
    ++$done;
    diag("$done / $total: $what") if defined $outfile;
}

sub quote {
    my($s) = @_;
    $s =~ s/'/'\\''/g;
    return "'$s'";
}

sub bench {
    my($spec, @opt) = @_;
    local $ENV{MULTIBENCH} = $spec;
    progress("MULTIBENCH=$spec");
    my @lines = grep /^(?:MULTIBENCH|[PRCSLGQ]) /,
            `'$verbose' -X @opt $n $k 2>&1`;
    @lines or die "no result for MULTIBENCH=$spec";
    chomp @lines;
    return @lines;
}

# Run the VERBOSE pcoul with gate records and stage timing (-dv6), and
# return its W and V records, split
sub gate_log {
    my(@args) = @_;
    local $ENV{GATE_STATS} = $tmp;
    unlink $tmp;
    progress("-dv6 @args");
    my $out = `'$verbose' -X -dv6 @{[ map quote($_), @args ]} 2>&1`;
    # a run cut short with -Ld ends with a 301 line instead
    $out =~ /^(?:367|301) /m or die "no 367 or 301 line from $verbose @args";
    open my $fh, '<', $tmp or die "$tmp: $!";
    # not $_, which a caller may be using
    my @recs;
    while (my $line = <$fh>) {
        push @recs, [ split ' ', $line ] if $line =~ /^[WV] /;
    }
    close $fh;
    unlink $tmp;
    return @recs;
}

# Run the VERBOSE pcoul with -ja1, recording 1 in 8 of its test
# preparations (-dv16), and return the T and U records.
sub prep_log {
    my(@args) = @_;
    local $ENV{GATE_STATS} = $tmp;
    unlink $tmp;
    progress("-ja1 -dv16 @args");
    my $cmd = "'$verbose' -X -ja1 -dv16 -Ld60 @{[ map quote($_), @args ]}";
    my $out = `$cmd 2>&1`;
    open my $fh, '<', $tmp or die "$tmp: $!";
    # 1 in 4 of the T records suffices, and 1 in 40 of the U records,
    # which are many more (11 million from one run); read a line at a
    # time, and not into $_, which a caller may be using
    my($it, $iu, @recs) = (0, 0);
    while (my $line = <$fh>) {
        my $keep = ($line =~ /^T /) ? !($it++ % 4)
                : ($line =~ /^U /) ? !($iu++ % 40) : 0;
        push @recs, [ split ' ', $line ] if $keep;
    }
    close $fh;
    unlink $tmp;
    (grep $_->[0] eq 'T', @recs) or die "no T records from $verbose @args";
    return @recs;
}

# Fit the cost of a test preparation to what it did, from the records of
# the calibration runs given (as prep_log() makes them): from T records,
# per call, per trial prime tested by limbs (1, 2, 3 or more), per gcd
# by trial band, per bit tested for primality and per power test; and
# that of a prime test's preparation from U records, by its result: its
# cost for values of up to PP_SMALL bits, its cost at PP_SMALL bits
# and per bit beyond, and what a second limb adds (see cm_pp_model() in
# coulcost.c), each given only where there are values to fit it to.
use constant PP_SMALL => 16;    # CM_PP_SMALL in coulcost.c
sub fit_prep {
    my(@runs) = @_;
    my(@rows, @urows, %usizes);
    # each run's records in turn, lest they all be held at once
    for my $run (@runs) {
        for (prep_log(@$run)) {
            if ($_->[0] eq 'U') {
                my(undef, $nbits, $res, $dt) = @$_;
                my $small = $nbits <= PP_SMALL;
                push @urows, [
                    map(($_ == $res ? $small ? (1, 0, 0, 0)
                            : (0, 1, $nbits - PP_SMALL, $nbits > 64 ? 1 : 0)
                        : (0, 0, 0, 0)), 0 .. 2),
                    $dt,
                ];
                $usizes{$res}{$nbits} = 1 unless $small;
                next;
            }
            my(undef, $nbits, $steps, @g) = @$_;
            my($npr, $pbits, $npow, $full, $zbits, $dt) = splice @g, 5;
            my $limbs = int(($nbits + 63) / 64);
            $limbs = 3 if $limbs > 3;
            push @rows, [ 1, map($_ == $limbs ? $steps : 0, 1 .. 3),
                    @g, $pbits, $npow, $zbits, $dt ];
        }
    }
    my @names = qw{ prepcall prepstep1 prepstep2 prepstep3 prepgcd0
            prepgcd1 prepgcd2 prepgcd3 prepgcd4 preppbit preppower
            prepzbit };
    my @c = lsq_weighted(\@names, \@rows);
    # a slope needs two sizes above PP_SMALL
    for my $res (0 .. 2) {
        next if keys %{ $usizes{$res} // {} } > 1;
        $_->[4 * $res + 2] = 0 for @urows;
    }
    my @unames = map {
        my $r = $_;
        map "pprep$r$_", qw{ small at16 bit limb };
    } 0 .. 2;
    my @u = @urows ? lsq_weighted(\@unames, \@urows) : ();
    # only the costs there were values to fit
    my @ufit = grep {
        my $j = $_;
        grep $_->[$j], @urows;
    } 0 .. $#u;
    return (map(sprintf('K %s %.5f', $names[$_], 1e6 * $c[$_]), 0 .. $#names),
            map(sprintf('K %s %.6f', $unames[$_], 1e6 * $u[$_]), @ufit));
}

# Fit the walks of the given cause (N linear, S fixed power) from
# -dv6 records, given the cost of a clock read in seconds and the runs
# as [ [ args ], records ]: returns microseconds per walk, per
# inverse-filter entry set up (linear) or per root residue (fixed
# power), per iteration and per inverse entry tested.
# The records carry the clock reads that time them, which a normal
# build does not make: each interval timed (the walk, and each test
# stage within it) takes in one read's worth, as does the time outside
# it, so the time outside the tests has a read for the walk and one for
# each stage, and one more where a square walk predicted its pass rate
# (see gs_square_pinv() in trace.c). Those are taken off rather than
# fitted, since the stages go nearly in step with the iterations, and a
# fitted cost per stage took an arbitrary share of the cost per
# iteration with it.
# Then it reports how well the fit describes each run (see
# check_fit()), since each run is there for walks of a shape that
# pcoul's choices may cease to give it.
sub fit_walks {
    my($cause, $read, @runs) = @_;
    my @run_rows;
    for my $run (@runs) {
        my($args, @recs) = @$run;
        my @rows;
        for (@recs) {
            my @f = @$_;
            next unless $f[0] eq 'W' && $f[6] eq $cause;
            # time outside the tests
            my $rest = $f[5] - $f[17] - $f[18];
            # stages: the inverse passes, and those passing each test
            my $reads = 1 + $f[14] + $f[15];
            # what was set up: inverse entries, or root residues; and the
            # iterations: ati, or roots
            my($setup, $iter) = ($f[9], $f[3]);
            if ($cause eq 'S') {
                $rest -= $f[23];
                $reads += $f[22] + ($f[28] == -1 ? 0 : 1);
                ($setup, $iter) = ($f[24], $f[21]);
            }
            # and the entries tested
            my $y = $rest - $reads * $read;
            push @rows, [ 1, $setup, $iter, $iter * $f[29], $y ];
        }
        push @run_rows, [ "@$args", \@rows ];
    }
    my @all = map @{ $_->[1] }, @run_rows;
    @all > 100 or die "too few $cause walks to fit";
    my @names = ($cause eq 'S')
            ? qw{ sqsetup sqsetupres sqloop0 sqtest }
            : qw{ linsetup linsetupinv loop0 looptest };
    my @c = lsq_weighted(\@names, \@all);
    check_fit(\@names, \@c, 'walks of iterations', 2, @run_rows);
    return map 1e6 * $_, @c;
}

# How well the costs @$c fit each run of @run_rows ([ label, rows ] as
# fit_walks() makes them): for its rows (walks, calls) by the size in
# column $bcol (iterations, primes), under 10, 10 to 999, and 1000 or
# more, their measured cost over their fitted cost, marked "!" if that
# is off by more than 15%; and the costs as fitted without the run, each
# marked "!" if off by more than 25%, as one the run decides, or "-" for
# a cost the rest cannot fit. A run there for rows of a shape the others
# lack decides some costs by design; a cost it decides unexpectedly, or
# one that fits it badly, may mean pcoul now searches it differently.
sub check_fit {
    my($names, $c, $what, $bcol, @run_rows) = @_;
    my $us = sub { join ' ', map sprintf('%.4g', 1e6 * $_), @_ };
    warn "multibench-table: fitted @$names: ", $us->(@$c), "\n";
    for my $i (0 .. $#run_rows) {
        my($label, $rows) = @{ $run_rows[$i] };
        my(%y, %f, %n);
        for my $r (@$rows) {
            my $fit = 0;
            $fit += $c->[$_] * $r->[$_] for 0 .. $#$c;
            my $size = ($r->[$bcol] < 10) ? '<10'
                    : ($r->[$bcol] < 1000) ? '10-999' : '1000+';
            $y{$size} += $r->[-1];
            $f{$size} += $fit;
            ++$n{$size};
        }
        my @size = map {
            my $ratio = $f{$_} > 0 ? $y{$_} / $f{$_} : 0;
            sprintf('%s: %d at %.3f%s', $_, $n{$_}, $ratio,
                    abs($ratio - 1) > 0.15 ? '!' : '');
        } grep $n{$_}, qw{ <10 10-999 1000+ };
        warn "multibench-table:   $label: $what ", join(', ', @size), "\n";
        next if @run_rows < 2;
        my @rest = map @{ $run_rows[$_][1] }, grep $_ != $i, 0 .. $#run_rows;
        my @o = eval { lsq_weighted(undef, \@rest) };
        my @fit = map {
            my $j = $_;
            !@o ? '-'
                : sprintf('%.4g', 1e6 * $o[$j])
                    . (abs($o[$j] - $c->[$j]) > 0.25 * $c->[$j] ? '!' : '');
        } 0 .. $#$c;
        warn "multibench-table:     fitted without it: @fit\n";
    }
}

# The cost of a clock read in seconds, from the bench.
sub clock_read {
    my($line) = grep /^MULTIBENCH clock read /, bench('clock');
    $line && $line =~ /read ([\d.]+)us/ or die "no clock read cost";
    return $1 * 1e-6;
}

# Fit walk_1_set() calls from V records, given the cost of a clock read
# in seconds and the runs as [ [ args ], records ]: returns microseconds
# per call, per prime, and per prime passing the check mod aq / q_i (as
# -ja counts them). As for walks (see fit_walks()), the time outside the
# tests is taken less a clock read for the call and one for each test
# stage, here a prime reaching test_1primes() or test_1multi(); and how
# well the fit describes each run is reported.
sub fit_w1s {
    my($read, @runs) = @_;
    my @run_rows;
    for my $run (@runs) {
        my($args, @recs) = @$run;
        my @rows;
        for (grep $_->[0] eq 'V', @recs) {
            my(undef, undef, undef, undef, $primes, $pass, $tprime, $tmulti,
                    $dt, $check, $ppass) = @$_;
            my $y = $dt - $tprime - $tmulti - (1 + $pass + $ppass) * $read;
            push @rows, [ 1, $primes, $check, $y ];
        }
        push @run_rows, [ "@$args", \@rows ];
    }
    my @all = map @{ $_->[1] }, @run_rows;
    (grep $_->[2] < $_->[1], @all) && (grep $_->[2] > 0, @all)
            or die "walk_1_set() calls too uniform to fit";
    my @names = qw{ w1scall w1siter w1scheck };
    my @c = lsq_weighted(\@names, \@all);
    check_fit(\@names, \@c, 'calls of primes', 1, @run_rows);
    return map 1e6 * $_, @c;
}

# As lsq_nonneg(), but each row weighted by the inverse of its fitted
# cost, refitting until that settles (iteratively reweighted least
# squares; a few rounds suffice): a row's cost is a sum of many small
# ones (iterations, trial primes), so its variance goes with its size.
# Unweighted, the few largest rows decide the fit, and how their cost per
# iteration differs a little from that of the rest moves the fixed cost
# far more than the many small rows say of it; weighted by the inverse of
# the square of their cost (relative error), the few large rows that
# alone determine the cost per iteration hardly count. A fitted cost
# below the tenth percentile of the costs measured is taken at that, lest
# a row near 0 take all the weight.
sub lsq_weighted {
    my($names, $rows) = @_;
    my @c = lsq_nonneg(undef, $rows);
    my @y = sort { $a <=> $b } grep $_ > 0, map $_->[-1], @$rows;
    my $floor = @y ? $y[int(@y / 10)] : 1e-9;
    for my $round (1 .. 5) {
        my @w = map {
            my $r = $_;
            my $fit = 0;
            $fit += $c[$_] * $r->[$_] for 0 .. $#c;
            1 / (($fit < $floor) ? $floor : $fit);
        } @$rows;
        @c = lsq_nonneg($round == 5 ? $names : undef, $rows, \@w);
    }
    return @c;
}

# As lsq(), but a coefficient that comes out negative (where columns are
# nearly collinear) is fixed at zero, with a warning naming it from
# @$names if given, and the rest refitted. A cost fixed so is one the
# calibration runs cannot tell apart from the others: worth looking into.
# Rows are weighted by @$w if given, as for lsq().
sub lsq_nonneg {
    my($names, $rows, $w) = @_;
    my $m = @{ $rows->[0] } - 1;
    # a column that is always zero has nothing to fit: it stays zero
    my @keep = grep {
        my $j = $_;
        grep $_->[$j], @$rows;
    } 0 .. $m - 1;
    while (1) {
        my @c = lsq($rows, \@keep, $w);
        my @neg = grep $c[$_] < 0, 0 .. $#c;
        if (!@neg) {
            my @full = (0) x $m;
            @full[@keep] = @c;
            return @full;
        }
        my %drop = map +($keep[$_] => 1), @neg;
        if ($names) {
            warn "multibench-table: $names->[$_] fitted negative,"
                    . " fixed at 0\n"
                for sort { $a <=> $b } keys %drop;
        }
        @keep = grep !$drop{$_}, @keep;
        @keep or die "lsq_nonneg: no columns left";
    }
}

# Least squares for y = sum x_j b_j over the columns @$cols of rows
# [ x_1 .. x_m, y ], each row weighted by $w->[i] if given (rather than
# making weighted copies of rows that may number millions): normal
# equations on scaled columns, Gaussian elimination with pivoting.
# Returns the coefficients of @$cols in order.
sub lsq {
    my($rows, $cols, $w) = @_;
    my $m = @$cols;
    my $yi = $#{ $rows->[0] };
    my @scale = (0) x $m;
    for my $k (0 .. $#$rows) {
        my $r = $rows->[$k];
        my $wk = $w ? $w->[$k] : 1;
        $scale[$_] += $wk * $r->[$cols->[$_]] ** 2 for 0 .. $m - 1;
    }
    @scale = map { $_ > 0 ? sqrt($_) : 1 } @scale;
    my(@A, @b);
    for my $k (0 .. $#$rows) {
        my $r = $rows->[$k];
        my $wk = $w ? $w->[$k] : 1;
        my @x = map $r->[$cols->[$_]] / $scale[$_], 0 .. $m - 1;
        for my $i (0 .. $m - 1) {
            my $wx = $wk * $x[$i];
            $b[$i] += $wx * $r->[$yi];
            $A[$i][$_] += $wx * $x[$_] for 0 .. $m - 1;
        }
    }
    for my $i (0 .. $m - 1) {
        my($p) = sort { abs($A[$b][$i]) <=> abs($A[$a][$i]) } $i .. $m - 1;
        @A[$i, $p] = @A[$p, $i];
        @b[$i, $p] = @b[$p, $i];
        abs($A[$i][$i]) > 1e-12 or die "lsq: singular";
        for my $j ($i + 1 .. $m - 1) {
            my $f = $A[$j][$i] / $A[$i][$i];
            $A[$j][$_] -= $f * $A[$i][$_] for $i .. $m - 1;
            $b[$j] -= $f * $b[$i];
        }
    }
    my @x;
    for (my $i = $m - 1; $i >= 0; --$i) {
        my $s = $b[$i];
        $s -= $A[$i][$_] * $x[$_] for $i + 1 .. $m - 1;
        $x[$i] = $s / $A[$i][$i];
    }
    return map $x[$_] / $scale[$_], 0 .. $m - 1;
}

# The cost per prime stubbed of the given kind ("leaf" for leaf loops
# with linear walks, "sq" for those with fixed powers, "tail" for the
# ends of loops of primes rejected on rq > zmax), from a calibration
# batch run with and without MOCK_LEAF_OFF (MOCK_TAIL_OFF for "tail"):
# the difference in real (unmocked) time over the number of primes
# stubbed. Leaf loops are calibrated with loop tails left to run, since
# the real loops include them, and loop tails with leaf loops run for
# real, so that none of their primes is strided.
sub cprime {
    my($kind, @args) = @_;
    my($var, $other) = ($kind eq 'tail')
            ? ('MOCK_TAIL_OFF', 'MOCK_LEAF_OFF')
            : ('MOCK_LEAF_OFF', 'MOCK_TAIL_OFF');
    my @table = map lines_of($_), @sections;
    open my $fh, '>', $tmp or die "$tmp: $!";
    print $fh "$_\n" for @table, map "C $_ 0",
            grep !(grep /^C $_ /, @table), qw{ cprime cprimesq ctail };
    close $fh;
    local $ENV{COST_TABLE} = $tmp;
    local $ENV{$other} = 1;
    my(%real, $primes);
    for my $rep (1 .. 3) {
        for my $off (1, 0) {
            local $ENV{$var};
            if ($off) {
                $ENV{$var} = 1;
            } else {
                delete $ENV{$var};
            }
            progress("mock @args" . ($off ? " ($kind off)" : ''));
            my $out = `'$mock' -X @{[ map quote($_), @args ]} 2>&1`;
            my($m, $pl, $ps, $pt) = $out
                    =~ /^368 mock ([\d.]+)s \(overhead [\d.]+s\), leaf primes (\d+), sq primes (\d+), strided \d+, tail (\d+)/m
                    or die "no 368 line from $mock";
            my($t) = $out =~ /^367 .*\(([\d.]+)s\)/m
                    or die "no 367 line from $mock";
            my $r = $t - $m;
            $real{$off} = $r if !defined($real{$off}) || $r < $real{$off};
            $primes = { leaf => $pl, sq => $ps, tail => $pt }->{$kind}
                    unless $off;
        }
    }
    $primes or die "calibration batch stubbed no $kind primes";
    my $c = 1e6 * ($real{1} - $real{0}) / $primes;
    if ($c < 0) {
        warn sprintf "multibench-table: %s cost per prime %.4fus negative,"
                . " fixed at 0\n", $kind, $c;
        $c = 0;
    }
    return $c;
}
