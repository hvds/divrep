#!/usr/bin/env perl
BEGIN { do "./lib/reexec" for grep $_, $ENV{MATHPERL} }
use strict;
use warnings;
use lib 'lib';
use Math::Prime::Util qw{ divisors factor_exp gcd };
use H::Diag qw{ diag keep_diag };

=head1 multibench-table: tabulate this machine's costs for the walk mocks

  multibench-table [-c<bench>] [-g<gatestats>] [-m<mock>] [-b<bits,...>]
          [-f<flake>] [-o | -M] [-w<file>] n k

Writes to stdout, or to I<file> with C<-w> (when progress is shown on
stdout as runs done / total), the cost table that a pcoul built with
C<MOCK_WALK=1>
(and C<MOCK_LEAF=1>) reads from C<$MOCK_WALK_TABLE>, so that the mocks
carry no costs of their own: one table per machine, MPUGMP build and
n. Times in the table are in microseconds. It needs three builds of
pcoul, given by C<-c> (C<MULTIBENCH=1>, default F<./pcoul>), C<-g>
(C<GATE_STATS=1>) and C<-m> (C<MOCK_WALK=1 MOCK_LEAF=1>).

The mock models the trial division stage of each test itself, since
how often the values a walk tests are divisible by each trial prime
depends strongly on the walk. So the bench pcoul first finds the trial
division limit L for each size (it changes at 80 bits in some builds),
the cost of a test that fails at each of a range of trial primes, and
the extra cost of a factor found there that does not end the test, at
sizes either side of the limb boundaries at 64 and 128 bits, since the
costs step up with each limb (the mock uses the nearest size with as
many limbs), giving lines:

  S bits p prep_us prime_us [extra_us]
  L bits L

Then for each divisor t > 2 of n and each size in the bits grid, it
feeds test_multi_append() random integers with no factor up to L,
giving one line per case:

  t e bits F rej dec pend pass prep_us run_us

where F is that L. Each t has a row with exponent multiplier e = 1 (a
need_other value, or what is left of one after trial division), and
each odd t also rows for each e = gcd(p - 1: p | t') for odd t' | n, as
used for the root of a fixed power (and what is left of it). The fractions are of inputs rejected in prep, fully
decided in prep, and left pending for the ladder; I<pass> is the
fraction of pending inputs the ladder accepts; the times are mean prep
time per input and mean ladder time per pending input. C<-o> skips
these lines, giving only the costs below, which do not depend on n;
C<-M> gives only these lines (and needs only the bench pcoul).

Then the remaining costs:

  P bits F pass us  a prime test of a value with no factor up to F = L
  R bits us us      the primality test prep makes when only a prime is
                    left to find, on the same inputs and on composites
  S, L              as above
  C loop0 us        linear walk, per ati
  C looptest us     linear walk, per inverse-filter entry tested
  C sqsetup us      fixed-power walk, per walk
  C sqloop0 us      fixed-power walk, per root
  C sqtest us       fixed-power walk, per inverse-filter entry tested
  C cprime us       innermost recurse loop, per prime
  C cprimesq us     likewise, for loops walking a fixed power
  C w1siter us      walk_1_set(), per prime
  C w1scheck us     walk_1_set(), per prime reaching the tests
  C ctail us        recurse loop, per prime in the stubbed end of a
                    loop whose primes are almost all rejected on rq > zmax
  G bits rung reach us hit fbits cprime
                    the factoring ladder of tau_multi_run()
  G bits 0 none     likewise, the fraction for which it found no factor

The walk loop costs are fitted by least squares to the walks of two
calibration runs with the GATE_STATS pcoul (time outside the tests,
against iterations, expected inverse entries tested and inverse-filter
passes, the last absorbing the instrumentation's own clock reads), and
the walk_1_set() costs likewise to its calls in one of those and a
third run.
C<cprime> and C<cprimesq> are each found by timing a calibration batch
with the mock pcoul, once with leaf loops stubbed and once with them run
for real: the difference in real (unmocked) time over the number of
primes stubbed. C<ctail> likewise, from a batch of D(162, 3) deep
enough that almost every prime its recursion tries is rejected on
rq > zmax, timed with the ends of such loops stubbed and run (and leaf
loops run for real in both, so that none of those primes is strided).

The G rows come from running the ladder on random composites of the
given size with no factor up to L, each alone and stopping at the
first factor found: per rung, the fraction of inputs reaching it, the
mean cost of an attempt there (including splitting a composite factor
found), the fraction of attempts finding a factor, and for those the
mean size of the prime factor and the fraction whose cofactor is prime.
From 100 bits the inputs are instead built from their factors, the
smallest from the distribution Buchstab's function gives (for
integers with no factor below L) with probability 0.3, else uniformly
in log, each weighted by the ratio of the densities: the same expected
results, with many more of the inputs that alone reach the costly high
rungs. (At 72 bits, where both can be run at length, built and random
inputs agree to within sampling error.) Above 191 bits there are no G
rows unless C<-f> is given; the mock uses the largest.

With C<-f>I<flake>, the table is for runs with C<-o>I<flake>: the ladder
is benched under the same option, which drops the rungs from QS on for
values above I<flake> bits (the failure handler then logs what is left,
to be factored separately), and sizes above 191 bits are added up to
511 (60 inputs each up to 255 bits, 30 to 299, 12 above: each input's
costliest rung is then a single ECM rung, 2.5s per attempt at 207
bits, 31s at 299, more above; so the largest are rough). The mock also
drops those rungs itself when run with C<-o>, but can only price the
sizes the table has.

None of these depends on what the value is being tested for, so the
mock derives the effect of a factor found on a test for tau(n^e) = t,
including restarting the ladder on the cofactor, and interleaves the
pending values of a call as tau_multi_run() does. The sizes are the
ends and some interior points of the size brackets in tmfb[] in
F<coultau.c>, which choose the rungs used, up to 191 bits.


=cut

my($bench, $gstats, $mock, $only, $outfile, $flake)
        = ('./pcoul', undef, undef, '', undef, 0);
# (with sizes either side of the limb boundaries at 64 and 128 bits,
# where costs step up)
my @bits = (16, 20, 24, 28, 32, 36, 40, 44, 48, 52, 56, 60, 64, 65, 72, 80,
        96, 112, 128, 129);
while (@ARGV && $ARGV[0] =~ /^-/) {
    my $arg = shift @ARGV;
    last if $arg eq '--';
    $bench = $1, next if $arg =~ /^-c(.+)$/;
    $gstats = $1, next if $arg =~ /^-g(.+)$/;
    $mock = $1, next if $arg =~ /^-m(.+)$/;
    @bits = split(/,/, $1), next if $arg =~ /^-b([\d,]+)$/;
    $flake = $1, next if $arg =~ /^-f(\d+)$/;
    $only = 'other', next if $arg eq '-o';
    $only = 'multi', next if $arg eq '-M';
    $outfile = $1, next if $arg =~ /^-w(.+)$/;
    die "Unknown option '$arg'";
}
@ARGV == 2 && (($gstats && $mock) || $only eq 'multi')
        or die "500 Usage: $0 [-c<bench>] -g<gatestats> -m<mock> [-b<bits,...>] [-o | -M] [-w<file>] n k";
my($n, $k) = @ARGV;
my $out = \*STDOUT;
if (defined $outfile) {
    open(my $fh, '>', $outfile) or die "$outfile: $!";
    $fh->autoflush(1);
    $out = $fh;
}

# calibration runs: walks under a fixed power (nqc == 1), linear walks,
# and a batch rich in leaf loops
my @cal_sq = ('-x1e17', 18, 4);
my @cal_lin = ('-j4', '-f5', '-g24', '-x393643805345636319',
        '-I2^2.3 . 2.5^5 3 2^7 . 2.3^5 5', '-b8', 96, 8);
my @cal_leaf = @cal_lin;
# and one rich in leaf loops walking a fixed power
my @cal_leafsq = ('-f3', '-j2', '-g16', '-x1e16:1e17', '-b1', 18, 4);
# walk_1_set() with every prime reaching the tests
my @cal_w1s = ('-f3', '-j2', '-g16', '-x1e16:1e17', '-b3', 18, 4);
# deep recursion where almost every prime fails on rq > zmax
my @cal_tail = ('-j2', '-f3', '-g60', '-x3068295382408046177023',
        '-I3^2.5^2.7^2.397^2 2^2 .', 162, 3);

my $tmp = "/tmp/multibench-table.$$";
$| = 1;

# the test_multi() rows: t for each divisor t > 2 of n with e = 1, and
# for odd t also with each e for the root of an odd t (whose trial
# division leaves any odd divisor of t with the same e)
my %E;
for my $t (grep $_ > 2 && ($_ & 1), divisors($n)) {
    my $e = 0;
    $e = gcd($e, $_->[0] - 1) for factor_exp($t);
    $E{$e} = 1;
}
my @te = map {
    my $t = $_;
    ([ $t, 1 ], ($t & 1) ? (map [ $t, $_ ], sort { $a <=> $b } keys %E) : ())
} grep $_ > 2, divisors($n);

# progress: the number of pcoul runs to make
# (the mock takes trial division costs from the nearest scan size with
# as many limbs)
my @scan_bits = (24, 40, 56, 64, 72, 80, 81, 128, 136);
my @prime_bits = (16, 18, 20, 21, 22, 24, 28, 32, 40, 48, 56, 64, 65, 72,
        80, 96, 112, 128, 129);
# the ladder: the size brackets of tmfb[] in coultau.c end at 53, 58, 63,
# 64, 72, 77, 89, 99, 126, 127, 159, 191; at 32 bits there are too few
# composites with no factor up to 64007 to find
my @ladder_bits = (36, 40, 44, 48, 52, 53, 56, 58, 60, 63, 64, 68, 72, 76,
        77, 80, 84, 88, 89, 92, 96, 99, 104, 112, 120, 126, 127, 136, 144,
        152, 159, 176, 191);
# with -f, beyond the reach of QS: the larger brackets end at 223, 255,
# 299, 511
push @ladder_bits, grep $_ > $flake, (207, 223, 239, 255, 277, 299, 400,
        511) if $flake;
my($done, $total) = (0, scalar @scan_bits);
$total += @te * @bits unless $only eq 'other';
$total += @prime_bits + @ladder_bits + 3 + 18 unless $only eq 'multi';

# Trial division: its limit L by size, and the cost of failing at each
# trial prime, at a range of sizes including those around 80 bits, where
# the limit changes. The test_multi() and prime test rows are for inputs
# with no trial factor, so each uses the L for its size.
# (an even t, since for odd t prep first checks for a square)
my $tscan = (grep $_ > 2 && !($_ & 1), divisors($n))[0] // 2;
# and an even t whose half is not 2, for the extra cost of a factor that
# does not end prep
my $tx = (grep $_ >= 6 && !($_ & 1), divisors($n))[0];
my @scan = map bench("scan,$_,2000,$tscan" . ($tx ? ",$tx" : '')),
        @scan_bits;
my %L = map { /^L (\d+) (\d+)/ ? ($1 => $2) : () } @scan;
sub trial_limit {
    my($bits) = @_;
    my($near) = sort { abs($a - $bits) <=> abs($b - $bits) } keys %L;
    return $L{$near};
}

unless ($only eq 'other') {
    for my $te (@te) {
        my($t, $e) = @$te;
        for my $b (@bits) {
            my $count = ($b <= 64) ? 5000 : ($b <= 80) ? 2000 : 500;
            my $F = trial_limit($b);
            my($line) = grep /^MULTIBENCH /, bench("$b,$t,$count,$F,1,$e");
            my @v = ($line // '') =~ m{
                fail\ ([\d.]+)\ decided\ ([\d.]+)\ pending\ ([\d.]+)
                \ \(pass\ ([\d.]+)\);\ prep\ ([\d.]+)us .* run\ ([\d.]+)us
            }x or die "no result for t=$t bits=$b";
            print $out join(' ', $t, $e, $b, $F, @v), "\n";
        }
    }
}

finish() if $only eq 'multi';
my @rest;
for my $b (@prime_bits) {
    push @rest, grep /^[PR] /, bench("prime,$b,20000," . trial_limit($b));
}
for my $b (@ladder_bits) {
    my $count = ($b <= 64) ? 3000 : ($b <= 99) ? 1500 : ($b <= 159) ? 400
            : 150;
    # from 100 bits, inputs built with their smallest factor oversampled
    # at large sizes, for the rare costly rungs
    my $alpha = ($b < 100) ? '' : ',0.3';
    $count = ($b <= 255) ? 60 : ($b <= 299) ? 30 : 12 if $b > 191;
    push @rest, grep /^G /, bench("ladder,$b,$count," . trial_limit($b)
            . $alpha, $flake ? "-o$flake" : ());
}
push @rest, @scan;
my @log_lin = gate_log(@cal_lin);
my @log_sq = gate_log(@cal_sq);
my @lin = fit_walks('N', @log_lin);
push @rest, sprintf('C loop0 %.5f', $lin[0]),
        sprintf('C looptest %.5f', $lin[1]);
my @sq = fit_walks('S', @log_sq);
push @rest, sprintf('C sqsetup %.4f', $sq[0]),
        sprintf('C sqloop0 %.5f', $sq[1]), sprintf('C sqtest %.5f', $sq[2]);
my @w1s = fit_w1s(@log_sq, gate_log(@cal_w1s));
push @rest, sprintf('C w1siter %.5f', $w1s[0]),
        sprintf('C w1scheck %.5f', $w1s[1]);
push @rest, sprintf('C cprime %.4f', cprime('leaf', @cal_leaf)),
        sprintf('C cprimesq %.4f', cprime('sq', @cal_leafsq));
push @rest, sprintf('C ctail %.4f', cprime('tail', @cal_tail));
print $out "$_\n" for @rest;
finish();

sub finish {
    keep_diag() if defined $outfile;
    close $out if defined $outfile;
    unlink $tmp;
    exit 0;
}

# count a pcoul run, showing progress when writing to a file
sub progress {
    my($what) = @_;
    ++$done;
    diag("$done / $total: $what") if defined $outfile;
}

sub quote {
    my($s) = @_;
    $s =~ s/'/'\\''/g;
    return "'$s'";
}

sub bench {
    my($spec, @opt) = @_;
    local $ENV{MULTIBENCH} = $spec;
    progress("MULTIBENCH=$spec");
    my @lines = grep /^(?:MULTIBENCH|[PRCSLG]) /,
            `'$bench' -X @opt $n $k 2>&1`;
    @lines or die "no result for MULTIBENCH=$spec";
    chomp @lines;
    return @lines;
}

# Run the GATE_STATS pcoul, and return its W and V records, split
sub gate_log {
    my(@args) = @_;
    local $ENV{GATE_STATS} = $tmp;
    unlink $tmp;
    progress("GATE_STATS @args");
    my $out = `'$gstats' -X @{[ map quote($_), @args ]} 2>&1`;
    $out =~ /^367 /m or die "no 367 line from $gstats @args";
    open my $fh, '<', $tmp or die "$tmp: $!";
    my @recs = map [ split ], grep /^[WV] /, <$fh>;
    close $fh;
    unlink $tmp;
    return @recs;
}

# Fit the walks of the given cause (N linear, S fixed power) from
# GATE_STATS records: returns microseconds per walk (S only), per
# iteration and per inverse entry tested.
sub fit_walks {
    my($cause, @recs) = @_;
    my @rows;
    for (@recs) {
        my @f = @$_;
        next unless $f[0] eq 'W' && $f[6] eq $cause;
        # time outside the tests
        my $rest = $f[5] - $f[17] - $f[18];
        if ($cause eq 'S') {
            $rest -= $f[23];
            push @rows, [ 1, $f[21], $f[21] * $f[29], $f[14], $rest ];
        } else {
            push @rows, [ $f[3], $f[3] * $f[29], $f[14], $rest ];
        }
    }
    @rows > 100 or die "too few $cause walks to fit";
    my @c = lsq_nonneg(\@rows);
    pop @c;     # inverse-filter passes: instrumentation
    return map 1e6 * $_, @c;
}

# Fit walk_1_set() calls from GATE_STATS V records: returns microseconds
# per prime and per prime reaching the tests.
sub fit_w1s {
    my(@recs) = @_;
    my @rows = map [ $_->[4], $_->[5], $_->[8] - $_->[6] - $_->[7] ],
            grep $_->[0] eq 'V', @recs;
    (grep $_->[1] < $_->[0], @rows) && (grep $_->[1] > 0, @rows)
            or die "walk_1_set() calls too uniform to fit";
    return map 1e6 * $_, lsq_nonneg(\@rows);
}

# As lsq(), but a coefficient that comes out negative (where columns are
# nearly collinear) is fixed at zero and the rest refitted.
sub lsq_nonneg {
    my($rows) = @_;
    my $m = @{ $rows->[0] } - 1;
    my @keep = (0 .. $m - 1);
    while (1) {
        my @c = lsq([ map [ @$_[@keep, $m] ], @$rows ]);
        my @neg = grep $c[$_] < 0, 0 .. $#c;
        if (!@neg) {
            my @full = (0) x $m;
            @full[@keep] = @c;
            return @full;
        }
        my %drop = map +($keep[$_] => 1), @neg;
        @keep = grep !$drop{$_}, @keep;
        @keep or die "lsq_nonneg: no columns left";
    }
}

# Least squares for y = sum x_j b_j, rows [ x_1 .. x_m, y ]: normal
# equations on scaled columns, Gaussian elimination with pivoting.
sub lsq {
    my($rows) = @_;
    my $m = @{ $rows->[0] } - 1;
    my @scale = (0) x $m;
    for my $r (@$rows) {
        $scale[$_] += $r->[$_] ** 2 for 0 .. $m - 1;
    }
    @scale = map { $_ > 0 ? sqrt($_) : 1 } @scale;
    my(@A, @b);
    for my $r (@$rows) {
        my @x = map $r->[$_] / $scale[$_], 0 .. $m - 1;
        for my $i (0 .. $m - 1) {
            $b[$i] += $x[$i] * $r->[$m];
            $A[$i][$_] += $x[$i] * $x[$_] for 0 .. $m - 1;
        }
    }
    for my $i (0 .. $m - 1) {
        my($p) = sort { abs($A[$b][$i]) <=> abs($A[$a][$i]) } $i .. $m - 1;
        @A[$i, $p] = @A[$p, $i];
        @b[$i, $p] = @b[$p, $i];
        abs($A[$i][$i]) > 1e-12 or die "lsq: singular";
        for my $j ($i + 1 .. $m - 1) {
            my $f = $A[$j][$i] / $A[$i][$i];
            $A[$j][$_] -= $f * $A[$i][$_] for $i .. $m - 1;
            $b[$j] -= $f * $b[$i];
        }
    }
    my @x;
    for (my $i = $m - 1; $i >= 0; --$i) {
        my $s = $b[$i];
        $s -= $A[$i][$_] * $x[$_] for $i + 1 .. $m - 1;
        $x[$i] = $s / $A[$i][$i];
    }
    return map $x[$_] / $scale[$_], 0 .. $m - 1;
}

# The cost per prime stubbed of the given kind ("leaf" for leaf loops
# with linear walks, "sq" for those with fixed powers, "tail" for the
# ends of loops of primes rejected on rq > zmax), from a calibration
# batch run with and without MOCK_LEAF_OFF (MOCK_TAIL_OFF for "tail"):
# the difference in real (unmocked) time over the number of primes
# stubbed. Leaf loops are calibrated with loop tails left to run, since
# the real loops include them, and loop tails with leaf loops run for
# real, so that none of their primes is strided.
sub cprime {
    my($kind, @args) = @_;
    my($var, $other) = ($kind eq 'tail')
            ? ('MOCK_TAIL_OFF', 'MOCK_LEAF_OFF')
            : ('MOCK_LEAF_OFF', 'MOCK_TAIL_OFF');
    open my $fh, '>', $tmp or die "$tmp: $!";
    print $fh "$_\n" for @rest, map "C $_ 0",
            grep !(grep /^C $_ /, @rest), qw{ cprime cprimesq ctail };
    close $fh;
    local $ENV{MOCK_WALK_TABLE} = $tmp;
    local $ENV{$other} = 1;
    my(%real, $primes);
    for my $rep (1 .. 3) {
        for my $off (1, 0) {
            local $ENV{$var};
            if ($off) {
                $ENV{$var} = 1;
            } else {
                delete $ENV{$var};
            }
            progress("mock @args" . ($off ? " ($kind off)" : ''));
            my $out = `'$mock' -X @{[ map quote($_), @args ]} 2>&1`;
            my($m, $pl, $ps, $pt) = $out
                    =~ /^368 mock ([\d.]+)s \(overhead [\d.]+s\), leaf primes (\d+), sq primes (\d+), strided \d+, tail (\d+)/m
                    or die "no 368 line from $mock";
            my($t) = $out =~ /^367 .*\(([\d.]+)s\)/m
                    or die "no 367 line from $mock";
            my $r = $t - $m;
            $real{$off} = $r if !defined($real{$off}) || $r < $real{$off};
            $primes = { leaf => $pl, sq => $ps, tail => $pt }->{$kind}
                    unless $off;
        }
    }
    $primes or die "calibration batch stubbed no $kind primes";
    return 1e6 * ($real{1} - $real{0}) / $primes;
}
