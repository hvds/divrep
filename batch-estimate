#!/usr/bin/env perl
BEGIN { do "./lib/reexec" for grep $_, $ENV{MATHPERL} }
use strict;
use warnings;
use Math::Prime::Util qw{ factor_exp primes gcd invmod powmod };

=head1 batch-estimate: predict the cost of a pcoul batch

Given a log written by pcoul built with C<GATE_STATS=1>, reads the
batch-level B, BP, BS and BM records of one batch (by default the first)
and predicts the time to process that batch for a given strategy
(C<-j>) and gain (C<-g>) over one or more values of C<-W>, printing
the predicted recursion and midp components.

  batch-estimate [-j<strategy>] [-g<gain>] [-b<index>] [-v] logfile W...

where each I<W> is a number or C<none> (meaning no C<-W>), and I<index>
counts batches in the log from 0. With C<-v>, also shows the predicted
work at each depth below the batch (recurse loops and primes tried,
walks and their size, walk_6x() calls), for comparison with the
GATE_STATS records of the real run.

=head2 Model

The recursion is idealised as follows. At each node the position to
allocate at is chosen by the strategy's rule, and the gate compares
C<gain * r> with the cap of its first allocation option, where I<r> is
the size of the walk that node would do: ati for a linear walk, root
iterations if one value is a fixed power. If it recurses, each prime
C<p> up to the cap is tried and the child continues with
C<r / p^(x-1)>, or C<r / p^((x-1)/g)> for an allocation at the fixed
power itself (whose root shrinks); the position's remaining tau and q
are updated, and its limit recomputed from the batch's mintau table.
A second fixed power makes it a Pell case, treated as nearly free. An
odd prime tau left at a position is enumerated by walk_1_set() without
-W, and left to the walks with it.

With C<-W>, caps are limited to I<W>, and walk_midp() allocates each
C<p^(x-1)> above I<W> once per position, walking from the batch level.

Walk cost per ati (linear) is
C<loop + P_inv * C_p + P_inv * P_prime * C_m>, where I<P_inv> is the
batch's inverse-filter pass rate and I<P_prime> the product over
need_prime positions of C<K / (b ln 2)> for a residual of I<b> bits.
Per root iteration (fixed power) it is
C<loop_sq + P_inv * (C_sq + P_sq * (C_p + P_prime * C_m))>, where
I<P_inv> is the pass rate over root residues and I<P_sq> the chance
that the root passes the fixed power's own test; each such walk also
costs I<setup_sq>. Each prime tried costs I<c_prime> (more with a
fixed power, whose residues must be updated). See
gate-cost-model-status.md for where these constants come from.

Only nqc <= 1 at the batch level is handled, and a fixed power arising
below the batch level is treated as the Pell case only if it is the
second one.

=cut

my %cost = (
    prime => 0.57e-6,   # c_prime: per prime tried in a recurse loop
    prime_sq => 4.3e-6, # c_prime with a fixed power present
    multi0 => 11e-6,    # C_m: per test_multi() call ...
    multi1 => 0.5e-6,   # ... plus this per need_other position
    tprime1 => 1.0e-6,  # C_p: per test_primes() call, npc > 0
    tprime0 => 0.1e-6,  # C_p: per test_primes() call, npc == 0
    loop => 0.03e-6,    # per ati, inverse filter loop
    loop_sq => 0.16e-6, # per root iteration, including mpz arithmetic
    test_sq => 0.6e-6,  # C_sq: the fixed power's own test, per call
    setup_sq => 2.5e-6, # per fixed-power walk
    pell => 20e-6,      # per Pell walk
    walk6x => 2.4e-6,   # per walk_6x() call
    walk1_flip => 0.47e-6,  # per prime iterated by walk_1_set() in a flip
    walk1 => 1e-6,      # per prime tried by walk_1_set()
    K => 4.8,           # prime density correction, need_prime residuals
    K_sq => 4.0,        # prime density correction, prime roots
);

# When the fixed power's tau is not prime, its root goes through the
# multi prep (trial division, then the ladder). The cost per call grows
# with the root's size: measured (bits, us) points D(54,4) -x1e16
# (19.2, 0.43), D(18,4) -x1e16 (26.1, 1.93), D(30,4) -x1e24 (39.4, 6.6),
# interpolated log-linearly and clamped outside. The pass rate depends
# on the shape the root must have: for t = 9 or 27 (r ~ pq) ~0.4, for
# t = 15 (r ~ pq^2) ~0.125; other shapes are not yet measured.
my @sq_multi_cost = ([ 19.2, 0.43e-6 ], [ 26.1, 1.93e-6 ], [ 39.4, 6.6e-6 ]);
my %sq_multi_pass = (9 => 0.4, 27 => 0.4, 15 => 0.125);
sub sq_multi {
    my($bits, $t) = @_;
    my $c = \@sq_multi_cost;
    my $cost;
    if ($bits <= $c->[0][0]) {
        $cost = $c->[0][1];
    } elsif ($bits >= $c->[-1][0]) {
        $cost = $c->[-1][1];
    } else {
        my $i = 1;
        ++$i while $bits > $c->[$i][0];
        my $f = ($bits - $c->[$i - 1][0]) / ($c->[$i][0] - $c->[$i - 1][0]);
        $cost = $c->[$i - 1][1] * ($c->[$i][1] / $c->[$i - 1][1]) ** $f;
    }
    return ($cost, $sq_multi_pass{$t} // 0.25);
}
my $EXACT = 1000;   # below this, primes are taken individually
my %work;           # with -v: predicted work at each depth
my %flip_work;      # with -v: run_flip_pqsq() counts

my($strategy, $gain, $index, $verbose) = (0, 1, 0, 0);
while (@ARGV && $ARGV[0] =~ /^-/) {
    my $arg = shift @ARGV;
    last if $arg eq '--';
    $strategy = $1, next if $arg =~ /^-j(\d)$/;
    $gain = $1, next if $arg =~ /^-g(\d+(?:\.\d+)?)$/;
    $index = $1, next if $arg =~ /^-b(\d+)$/;
    $verbose = 1, next if $arg eq '-v';
    die "Unknown option '$arg'";
}
@ARGV >= 2 or die "500 Usage: $0 [-j<strategy>] [-g<gain>] [-b<index>] [-v] logfile W...";
my($logfile, @W) = @ARGV;
my $batch = read_batch($logfile, $index);
# -j4 sets highpow: powers of 2 are allocated too
my $highpow = ($strategy == 4);

printf "batch %d at level %s: X=%.4g pinv=%.4f%s%s\n", $index,
        @$batch{qw{ level X pinv }},
        (($batch->{strategy} // 0) == 5) ? ' (STRATEGY_6X)' : '',
        $batch->{sq} ? sprintf(
            ", fixed power at v_%d (t=%d, g=%d) Xsq=%.4g pinv_sq=%.4f",
            @{ $batch->{sq} }{qw{ vi t g Xsq pinv }}) : '';

for my $warg (@W) {
    my $w = ($warg eq 'none') ? 9**9**9 : $warg;
    my %memo;
    my $root = initial_state($batch);
    %work = %flip_work = ();
    my $rec = node_cost($w, $root, $verbose ? {} : \%memo, 1);
    my $mid = ($warg eq 'none') ? 0 : midp_cost($w, $root);
    printf "  j=%d g=%s W=%-8s predicted %8.2fs (recursion %8.2fs, midp %7.2fs)\n",
            $strategy, $gain, $warg, $rec + $mid, $rec, $mid;
    if ($verbose) {
        printf "    flips: outer %.4g, accepted %.4g, inner %.4g\n",
                map $flip_work{$_} // 0, qw{ outer outer_ok inner } if %flip_work;
        for my $d (sort { $a <=> $b } keys %work) {
            my $h = $work{$d};
            printf "    depth %d: recurse %.4g (primes %.4g), walks %.4g (size %.4g), walk_6x %.4g, flip %.4g\n",
                    $d, map $h->{$_} // 0, qw{ recurse primes walks size w6x flip };
        }
    }
}
exit 0;

sub read_batch {
    my($file, $want) = @_;
    my(%b, @bp, %mintau, %restricted);
    my $seen = 0;
    open my $fh, '<', $file or die "$file: $!";
    while (<$fh>) {
        my @f = split;
        next unless $f[0] =~ /^B/;
        if ($f[0] eq 'B') {
            if ($seen++ == $want) {
                @b{qw{ level X pinv zbits cpu k strategy }} = @f[1 .. 7];
                last;
            }
            (@bp, %mintau, %restricted) = ();
            delete $b{sq};
        } elsif ($seen == $want) {
            if ($f[0] eq 'BP') {
                push @bp, [ @f[1 .. 6] ];
            } elsif ($f[0] eq 'BM') {
                $mintau{$f[1]} = log($f[2]) / log(2);
            } elsif ($f[0] eq 'BR') {
                $restricted{$f[2]}{$f[1]} = $f[3] ? log($f[3]) / log(2) : undef;
            } elsif ($f[0] eq 'BS') {
                my %s;
                @s{qw{ vi t g rc root Xsq pinv q }} = @f[1 .. 8];
                $b{sq} = \%s;
            }
        }
    }
    close $fh;
    defined $b{X} or die "No batch $want found in $file";
    $b{mintau} = \%mintau;
    $b{restricted} = \%restricted;

    # per-position state: remaining t and log2(q)
    my %pos;
    for (@bp) {
        my($vi, $x, $t, $L, $qbits, $maxforce) = @$_;
        $pos{$vi} = { t => $t, qbits => $qbits, maxforce => $maxforce };
    }
    $b{pos} = \%pos;
    # primes up to the greatest maxforce are fixed by the batch: pcoul
    # tries them but apply_single() rejects them
    my($fmax) = sort { $b <=> $a } map $_->{maxforce}, values %pos;
    $b{fmax} = $fmax // 0;
    return \%b;
}

sub initial_state {
    my($b) = @_;
    my %s = (
        pos => { map +($_ => { %{ $b->{pos}{$_} } }), keys %{ $b->{pos} } },
        nsq => $b->{sq} ? 1 : 0,
        npc => 0,
        pp => 1,
        pinv => 1,      # further inverse-filter factor from allocations
    );
    for my $vi (keys %{ $s{pos} }) {
        my $p = $s{pos}{$vi};
        next unless $p->{t} == 2;
        ++$s{npc};
        $s{pp} *= p_prime($b->{zbits} - $p->{qbits});
    }
    if ($b->{sq}) {
        $s{r} = $b->{sq}{Xsq};
        $s{root_bits} = log($b->{sq}{root}) / log(2);
    } else {
        $s{r} = $b->{X};
    }
    return \%s;
}

# approximate count of primes <= x
sub li {
    my($x) = @_;
    return 0 if $x < 2;
    my $l = log($x);
    return $x / $l * (1 + 1 / $l + 2 / $l ** 2);
}

# split primes in [lo, hi] into [count, p, exact], with primes below
# $EXACT listed individually and the rest in geometric buckets
sub buckets {
    my($lo, $hi) = @_;
    my $step = 2 ** 0.125;
    my @b;
    my $top = ($hi < $EXACT) ? $hi : $EXACT;
    push @b, map [ 1, $_, 1 ], @{ primes(int($lo) + 1, int($top)) } if $lo < $top;
    $lo = $top if $lo < $top;
    for (my $l = $lo; $l < $hi; $l *= $step) {
        my $h = $l * $step;
        $h = $hi if $h > $hi;
        my $count = li($h) - li($l);
        push @b, [ $count, sqrt($l * $h) ] if $count > 0;
    }
    return @b;
}

sub p_prime {
    my($bits, $K) = @_;
    $K //= $cost{K};
    $bits = 1 if $bits < 1;
    my $p = $K / ($bits * log(2));
    return $p > 1 ? 1 : $p;
}

sub is_pow2 { my($t) = @_; return !($t & ($t - 1)) }
sub odd_high { my($t) = @_; my @f = factor_exp($t); return $f[-1][0] }
sub is_prime_t { my($t) = @_; my @f = factor_exp($t); return @f == 1 && $f[0][1] == 1 }
sub high { my($t) = @_; my @f = factor_exp($t); return @f ? $f[-1][0] : 1 }
# sum of (p - 1) over the prime factors of t, with multiplicity
sub sumpm { my($t) = @_; my $s = 0; $s += ($_->[0] - 1) * $_->[1] for factor_exp($t); return $s }

# the allocations recurse() tries at a position with remaining t: divisors
# x of t sharing its highest prime (divisors[t].highdiv), smallest first
sub options {
    my($t) = @_;
    my $h = high($t);
    return () if $h <= ($highpow ? 1 : 2);
    return grep { $t % $_ == 0 && $_ % $h == 0 } $h .. $t;
}

# the allocations walk_midp() tries: every non-power-of-2 divisor of t
sub midp_options {
    my($t) = @_;
    return grep { $t % $_ == 0 && !is_pow2($_) } 3 .. $t;
}

# limit on p for allocating p^(x-1) at a position with remaining t, q,
# following limit_p()
sub limit {
    my($st, $p, $x) = @_;
    my $rest = $p->{t} / $x;
    my $bits = $batch->{zbits} - $p->{qbits};
    if (is_pow2($x)) {
        # highpow: allocating p^(x-1) leaves nextt = 2^b, and no smaller
        # prime divides the rest, so the limit is zmax^(1/(x-1+b))
        my $b = 0;
        $b++ while $rest > (1 << $b);
        return 2 ** ($bits / ($x - 1 + $b));
    }
    if ($x == $rest && is_prime_t($x)) {
        # this and the remaining allocation are p^(x-1).q^(x-1)
        return 2 ** ($bits / (2 * ($x - 1)));
    }
    if (($batch->{strategy} // 0) == 5 && $rest == 2) {
        # STRATEGY_6X: v_i >= 8 p^(x-1) (p^(x-1) - 1)
        return 1 + 2 ** (($batch->{zbits} - 3) / (2 * ($x - 1)));
    }
    my $r = $batch->{restricted}{$x};
    if ($r && high($x) == high($rest)) {
        # the next allocation at this position is either x again with a
        # higher prime, or a higher power sharing x's highest prime
        my $best;
        $best = $bits - $r->{$rest} if defined $r->{$rest};
        my($itert, $iter) = ($rest, 1);
        while ($itert % $x == 0) {
            ++$iter;
            $itert /= $x;
            next unless defined $r->{$itert};
            my $v = ($bits - $r->{$itert}) / $iter;
            $best = $v if !defined($best) || $v > $best;
        }
        return defined($best) ? 2 ** ($best / ($x - 1)) : 0;
    }
    my $mt = ($rest > 1) ? $batch->{mintau}{$rest} // 0 : 0;
    return 2 ** (($bits - $mt) / ($x - 1));
}

sub choose {
    my($st, $capped) = @_;
    if (($batch->{strategy} // 0) == 5) {
        # STRATEGY_6X: allocate at v_{sq0-2} until its tau is 2, then
        # walk_6x(); odd tau there makes a second square (Pell case)
        my $vi = $batch->{sq}{vi} - 2;
        my $p = $st->{pos}{$vi};
        return 'walk' if !$p || ($p->{t} & 1) || is_pow2($p->{t}) && $p->{t} > 2;
        return '6x' if $p->{t} == 2;
        return $vi;
    }
    return choose4($st, $capped) if $strategy == 4;
    my($best, $bkey);
    for my $vi (sort { $a <=> $b } keys %{ $st->{pos} }) {
        my $p = $st->{pos}{$vi};
        my $t = $p->{t};
        next if is_pow2($t);
        next if $capped && ($t & 1) && is_prime_t($t);
        my @key = ($strategy == 0) ? ($t, $p->{qbits})
                : ($strategy == 1) ? (odd_high($t), $t, $p->{qbits})
                : ($strategy == 2) ? (-$t, $p->{qbits})
                : die "strategy $strategy not supported";
        if (!defined($best) || cmp_key(\@key, $bkey) > 0) {
            ($best, $bkey) = ($vi, \@key);
        }
    }
    return $best;
}

# best_v4(): highest prime dividing t, then highest t, then highest q;
# if only powers of 2 remain, the smallest range lim - min, where
# lim = ((zmax + i)/q)^(1/sumpm(t)) and min is the last prime if the last
# allocation there was a power of 2, else maxforce
sub choose4 {
    my($st, $capped) = @_;
    my($best, $bh, $bt, $bq, $brange);
    for my $vi (sort { $a <=> $b } keys %{ $st->{pos} }) {
        my $p = $st->{pos}{$vi};
        my $t = $p->{t};
        next if $t <= 1;
        next if $capped && ($t & 1) && is_prime_t($t);
        my $h = high($t);
        my $range;
        if ($h == 2) {
            my $lim = 2 ** (($batch->{zbits} - $p->{qbits}) / sumpm($t));
            my $min = (defined($p->{lastx}) && is_pow2($p->{lastx}))
                    ? $p->{lastp} : $p->{maxforce};
            $range = $lim - $min;
        }
        if (defined $best) {
            next if $h < $bh;
            if ($h == $bh) {
                if ($h > 2) {
                    next if $t < $bt || ($t == $bt && $p->{qbits} <= $bq);
                } else {
                    next if $range >= $brange;
                }
            }
        }
        ($best, $bh, $bt, $bq, $brange) = ($vi, $h, $t, $p->{qbits}, $range);
    }
    return $best;
}

sub cmp_key {
    my($a, $b) = @_;
    for (0 .. $#$a) {
        my $c = $a->[$_] <=> $b->[$_];
        return $c if $c;
    }
    return 0;
}

sub walk_cost {
    my($st) = @_;
    return $cost{pell} if $st->{nsq} >= 2;
    my $pr = $st->{npc} ? $cost{tprime1} : $cost{tprime0};
    my $noc = $batch->{k} - $st->{npc} - $st->{nsq};
    my $multi = $cost{multi0} + $noc * $cost{multi1};
    if ($st->{nsq}) {
        my $sq = $batch->{sq};
        my($ctest, $psq) = is_prime_t($st->{pos}{ $sq->{vi} }{t})
                ? ($cost{test_sq}, p_prime($st->{root_bits}, $cost{K_sq}))
                : sq_multi($st->{root_bits}, $st->{pos}{ $sq->{vi} }{t});
        # a walk expected to cover r < 1 root iterations mostly never
        # happens: apply_single() rejects the allocation on overflow
        my $setup = $cost{setup_sq} * ($st->{r} < 1 ? $st->{r} : 1);
        return $setup + $st->{r} * ($cost{loop_sq}
                + $sq->{pinv} * $st->{pinv}
                * ($ctest + $psq * ($pr + $st->{pp} * $multi)));
    }
    return $st->{r} * ($cost{loop} + $batch->{pinv} * $st->{pinv}
            * ($pr + $st->{pp} * $multi));
}

# how many residues of the fixed power's root survive an allocation
# p^(x-1) at another position vi: q_s.r^g == s - vi (mod p^(x-1)) has
# gcd(g, p - 1) roots if (s - vi) / q_s is a g-th power residue, else
# none; for bucketed primes, the average of 1
sub root_factor {
    my($vi, $p, $exact) = @_;
    my $sq = $batch->{sq};
    return 1 unless $exact && $sq && $vi != $sq->{vi};
    my $d = ($sq->{vi} - $vi) % $p;
    return 1 if $d == 0 || $sq->{q} % $p == 0;
    my $c = $d * invmod($sq->{q} % $p, $p) % $p;
    my $h = gcd($sq->{g}, $p - 1);
    return (powmod($c, ($p - 1) / $h, $p) == 1) ? $h : 0;
}

# average over primes of 1 / gcd(g, p - 1), the chance that a random
# residue is a g-th power residue mod p
{
    my %mean;
    sub mean_survive {
        my($g) = @_;
        return $mean{$g} //= do {
            my @p = @{ primes($EXACT, 20 * $EXACT) };
            my $sum = 0;
            $sum += 1 / gcd($g, $_ - 1) for @p;
            $sum / @p;
        };
    }
}

# state after allocating p^(x-1) at position vi
sub allocate {
    my($st, $vi, $x, $p, $factor) = @_;
    $factor //= 1;
    my %c = (%$st, pos => { %{ $st->{pos} } });
    # the new allocation excludes one residue class mod p from the walk
    $c{pinv} = $st->{pinv} * (1 - 1 / $p);
    my $old = $st->{pos}{$vi};
    my $new = { %$old, t => $old->{t} / $x, lastx => $x, lastp => $p,
            qbits => $old->{qbits} + ($x - 1) * log($p) / log(2) };
    $c{pos}{$vi} = $new;
    my $sq = $batch->{sq};
    if ($sq && $vi == $sq->{vi}) {
        $c{r} = $st->{r} / $p ** (($x - 1) / $sq->{g});
        $c{root_bits} = $st->{root_bits} - ($x - 1) / $sq->{g} * log($p) / log(2);
    } else {
        $c{r} = $st->{r} * $factor / $p ** ($x - 1);
        ++$c{nsq} if ($new->{t} & 1) && $new->{t} > 1;
    }
    if ($new->{t} == 2) {
        ++$c{npc};
        $c{pp} *= p_prime($batch->{zbits} - $new->{qbits});
    }
    return \%c;
}

sub state_key {
    my($st) = @_;
    return join ' ', $st->{depth} // 0, int(16 * log($st->{r}) / log(2)), $st->{nsq}, $st->{npc},
            int(8 * log($st->{pp})), map {
                my $p = $st->{pos}{$_};
                "$_:$p->{t}:" . int($p->{qbits}) . ':'
                        . ($p->{lastx} // 0) . ':' . int($p->{lastp} // 0);
            } sort { $a <=> $b } keys %{ $st->{pos} };
}

# the prime after which prep_unforced_x() starts allocating p^(x-1) at a
# position, or undef if it skips this x
sub start_prime {
    my($p, $x) = @_;
    my $nextt = $p->{t} / $x;
    my $lastx = $p->{lastx} // 0;
    if (is_pow2($x)) {
        # powers of 2: increasing p, not decreasing powers
        return ($lastx && is_pow2($lastx)) ? $p->{lastp} : $p->{maxforce};
    }
    return $p->{lastp} if $x == $lastx;
    return undef if $x < $lastx && high($x) == high($lastx);
    return undef if $x > $nextt && high($x) == high($nextt);
    return $p->{maxforce};
}

# record predicted work (weight: expected number of such nodes)
sub note {
    my($depth, $weight, %add) = @_;
    return unless $verbose;
    $work{$depth}{$_} += $weight * $add{$_} for keys %add;
}

# If allocating p^(x-1) at vi with t = 2x^2 (x prime), the continuation
# allocates x again with a higher prime; once its limit falls below p it
# is empty, and recurse() stops this loop and hands the remainder to
# run_flip_pqsq(). Returns the prime where that happens, if below cap.
sub flip_point {
    my($st, $vi, $x, $start, $cap) = @_;
    my $p = $st->{pos}{$vi};
    return undef unless is_prime_t($x) && $p->{t} == 2 * $x * $x;
    my $empty = sub {
        my($q) = @_;
        my $c = allocate($st, $vi, $x, $q, 1);
        return limit($c, $c->{pos}{$vi}, $x) < $q;
    };
    return undef unless $empty->($cap);
    return $start if $empty->($start + 1);
    my($lo, $hi) = (log($start + 1), log($cap));
    for (1 .. 40) {
        my $mid = ($lo + $hi) / 2;
        if ($empty->(exp($mid))) { $hi = $mid } else { $lo = $mid }
    }
    return exp($hi);
}

# run_flip_pqsq(): allocate p^(2x-1) at vi for each p up to its limit,
# then walk_1_set() over q^(x-1) from the flip point up to the rest
sub flip_cost {
    my($st, $vi, $x, $pf) = @_;
    my $p = $st->{pos}{$vi};
    my $bits = $batch->{zbits} - $p->{qbits};
    my $xl = 2 * $x;
    my $lim = 2 ** ($bits / ($xl - 1));
    my $cprime = $st->{nsq} ? $cost{prime_sq} : $cost{prime};
    # if p^(2x-1) leaves an odd tau, v_i becomes a further fixed power,
    # which apply_allocv() rejects about half the time as impossible
    my $rest = $p->{t} / $xl;
    my $square_ok = (($rest & 1) && $rest > 1) ? 0.5 : 1;
    my $cost = 0;
    for (buckets($p->{maxforce}, $lim)) {
        my($count, $q, $exact) = @$_;
        $cost += $count * $cprime;
        # chance the existing fixed power still has roots: exact below
        # $EXACT, else 1 / (number of roots when there are any)
        my $f = root_factor($vi, $q, $exact);
        my $survive = !$batch->{sq} || $vi == $batch->{sq}{vi} ? 1
                : $exact ? ($f ? 1 : 0) : mean_survive($batch->{sq}{g});
        $survive *= $square_ok;
        next unless $survive;
        $flip_work{outer_ok} += $count * $survive;
        my $phigh = 2 ** (($bits - ($xl - 1) * log($q) / log(2)) / ($x - 1));
        next if $phigh <= $pf;
        my $inner = $count * $survive * (li($phigh) - li($pf));
        $cost += $inner * $cost{walk1_flip};
        $flip_work{inner} += $inner;
    }
    $flip_work{outer} += li($lim) - li($p->{maxforce});
    return $cost;
}

sub node_cost {
    my($w, $st, $memo, $weight) = @_;
    my $depth = $st->{depth} // 0;
    my $walk = walk_cost($st);
    if ($st->{nsq} >= 2 || $st->{r} < 1e-4) {
        note($depth, $weight, walks => 1, size => $st->{r});
        return $walk;
    }
    my $capped = $w < 9**9**9;
    my $vi = choose($st, $capped);
    if (!defined($vi) || $vi eq 'walk') {
        note($depth, $weight, walks => 1, size => $st->{r});
        return $walk;
    }
    if ($vi eq '6x') {
        note($depth, $weight, w6x => 1);
        return $cost{walk6x};
    }
    my $key = state_key($st);
    return $memo->{$key} if exists $memo->{$key};

    my $p = $st->{pos}{$vi};
    my $cprime = $st->{nsq} ? $cost{prime_sq} : $cost{prime};
    my $cost = 0;
    my $first = 1;
    for my $x (options($p->{t})) {
        my $start = start_prime($p, $x);
        next unless defined $start;
        my $L = limit($st, $p, $x);
        my $cap = ($w < $L) ? $w : $L;
        if ($x == $p->{t}) {
            # odd prime tau: walk_1_set() enumerates p directly
            $cost += $cost{walk1} * (li($cap) - li($start)) if $cap > $start;
            $first = 0;
            next;
        }
        next if $cap <= $start && !$first;
        # the gate is decided on the first option
        if ($first && $gain * $st->{r} < $cap - $start) {
            note($depth, $weight, walks => 1, size => $st->{r});
            return $memo->{$key} = $walk;
        }
        $first = 0;
        next if $cap <= $start;
        my $pf = flip_point($st, $vi, $x, $start, $cap);
        if (defined $pf) {
            $cost += flip_cost($st, $vi, $x, $pf);
            note($depth, $weight, flip => 1);
            $cap = $pf;
        }
        $cost += $cprime * (li($cap) - li($start));
        note($depth, $weight, recurse => 1, primes => li($cap) - li($start));
        for (buckets($start, $cap)) {
            my($count, $q, $exact) = @$_;
            next if $exact && $q <= $batch->{fmax};
            my $f = root_factor($vi, $q, $exact);
            next unless $f;
            my $n = $count;
            if (!$exact && $st->{nsq} && $vi != $batch->{sq}{vi}) {
                # only some bucketed primes leave the fixed power any roots;
                # those that do have correspondingly more
                my $ms = mean_survive($batch->{sq}{g});
                $n *= $ms;
                $f /= $ms;
            }
            my $child = allocate($st, $vi, $x, $q, $f);
            $child->{depth} = $depth + 1;
            $cost += $n * node_cost($w, $child, $memo, $weight * $n);
        }
    }
    return $memo->{$key} = $cost;
}

sub midp_cost {
    my($w, $st) = @_;
    my $cprime = $st->{nsq} ? $cost{prime_sq} : $cost{prime};
    my $cost = 0;
    for my $vi (keys %{ $st->{pos} }) {
        my $p = $st->{pos}{$vi};
        next if is_pow2($p->{t});
        next if ($p->{t} & 1) && is_prime_t($p->{t});
        for my $x (midp_options($p->{t})) {
            my $L = limit($st, $p, $x);
            next if $w >= $L;
            for (buckets($w, $L)) {
                my($count, $q, $exact) = @$_;
                my $f = root_factor($vi, $q, $exact);
                $cost += $count * $cprime;
                $cost += $count * walk_cost(allocate($st, $vi, $x, $q, $f)) if $f;
            }
        }
    }
    return $cost;
}
